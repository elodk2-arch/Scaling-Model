	measure 'Selected Driver Split' = ```
			
			VAR SubstreamAbbrev =
			    SELECTEDVALUE('Driver Map'[Substream Abbreviation])
			RETURN
			    SWITCH(
			        TRUE(),
			        SubstreamAbbrev = "SD", SELECTEDVALUE('Driver Map'[Driver Name]),
			        SubstreamAbbrev = "ES", SELECTEDVALUE('Driver Map'[Driver Name]),
			        SELECTEDVALUE('Driver Map'[Driver Family])
			    )
			
			```
