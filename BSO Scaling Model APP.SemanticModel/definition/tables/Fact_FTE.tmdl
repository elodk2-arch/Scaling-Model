table Fact_FTE
	lineageTag: 6e35f6f3-c66d-482d-9a06-abaae5d698a6

	measure 'Active FTE new' =
			
			CALCULATE(
			    SUM('Fact_FTE'[Active FTE]),
			    TREATAS(
			        VALUES('Fact_Actuals'[YearMonth]),
			        'Fact_FTE'[YearMonth]
			    )
			)
		formatString: 0.00
		lineageTag: 7e1fcb31-b791-4f63-856b-b9c9f8d69e4c

	measure 'Activity Scaled FTE Weighted' = ```
			
			VAR CurrentSubstream = SELECTEDVALUE('Sub_stream_combiner'[Substream abbreviation])
			
			// Check if there's a driver filter active
			VAR DriverFilterActive = 
			    ISFILTERED('Fact_Actuals'[Driver Name])
			    && NOT ISBLANK(SELECTEDVALUE('Fact_Actuals'[Driver Name]))
			
			// Get weights for current substream
			VAR WeightTable = 
			    FILTER(
			        BaseProcessWeights,
			        BaseProcessWeights[SubStream] = CurrentSubstream
			    )
			VAR HasWeights = COUNTROWS(WeightTable) > 0
			
			// If driver is filtered OR substream has no weights → just return regular activity scaled
			VAR RegularActivityScaled = [Activity Scaled FTE]
			
			// If substream has weights and no driver filter → calculate weighted avg
			VAR WeightedResult = 
			    SUMX(
			        WeightTable,
			        VAR ThisDriver = BaseProcessWeights[Driver]
			        VAR ThisWeight = BaseProcessWeights[Weight] / 100
			        VAR DriverActivityScaled = 
			            CALCULATE(
			                [Activity Scaled FTE],
			                'Fact_Actuals'[Driver Name] = ThisDriver
			            )
			        RETURN
			            DriverActivityScaled * ThisWeight
			    )
			
			RETURN
			    IF(
			        HasWeights && NOT DriverFilterActive,
			        WeightedResult,
			        RegularActivityScaled
			    )
			```
		lineageTag: 4875365f-6ae1-4b68-8bb0-7a84c042b4ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity Scaled FTE + Eff Weighted' = ```
			
			VAR CurrentSubstream = SELECTEDVALUE('Sub_stream_combiner'[Substream abbreviation])
			
			VAR DriverFilterActive = 
			    ISFILTERED('Fact_Actuals'[Driver Name])
			    && NOT ISBLANK(SELECTEDVALUE('Fact_Actuals'[Driver Name]))
			
			VAR WeightTable = 
			    FILTER(
			        BaseProcessWeights,
			        BaseProcessWeights[SubStream] = CurrentSubstream
			    )
			VAR HasWeights = COUNTROWS(WeightTable) > 0
			
			VAR RegularResult = [Activity Scaled FTE + Eff]
			
			VAR WeightedResult = 
			    SUMX(
			        WeightTable,
			        VAR ThisDriver = BaseProcessWeights[Driver]
			        VAR ThisWeight = BaseProcessWeights[Weight] / 100
			        VAR DriverResult = 
			            CALCULATE(
			                [Activity Scaled FTE + Eff],
			                'Fact_Actuals'[Driver Name] = ThisDriver
			            )
			        RETURN
			            DriverResult * ThisWeight
			    )
			
			RETURN
			    IF(
			        HasWeights && NOT DriverFilterActive,
			        WeightedResult,
			        RegularResult
			    )
			```
		lineageTag: 2a21b978-e47b-4bea-903d-7856c397107f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity Scaled FTE GL' = ```
			
			VAR MonthCount = DISTINCTCOUNT('DateTable'[YearMonth])
			VAR VacancyRate = 0.087
			
			VAR DriverTable =
			    ADDCOLUMNS(
			        VALUES(Fact_Actuals[Driver Name]),
			        "DriverWeight",
			            LOOKUPVALUE(
			                BaseProcessWeights[Weight],
			                BaseProcessWeights[SubStream], MAX(Fact_Actuals[Substream Abbreviation]),
			                BaseProcessWeights[Driver], [Driver Name]
			            ) / 100
			    )
			
			VAR WeightedResult =
			    SUMX(
			        DriverTable,
			        VAR LYTotalDriver =
			            CALCULATE(
			                [Total Driver new],
			                'DateTable'[Year] = YEAR(TODAY()) - 1,
			                ALL('DateTable')
			            )
			        VAR LYFTEAvg = 
			            CALCULATE(
			                [Active FTE Avg],
			                'DateTable'[Year] = YEAR(TODAY()) - 1,
			                ALL('DateTable')
			            )
			        VAR Baseline =
			            DIVIDE(
			                LYTotalDriver,
			                LYFTEAvg * (1 + VacancyRate)
			            )
			        VAR AdjustedBaseline =
			            IF(
			                MonthCount = 1,
			                Baseline / 12,
			                Baseline
			            )
			        VAR DriverScaled =
			            DIVIDE(
			                CALCULATE([Total Driver new]),
			                AdjustedBaseline
			            )
			        RETURN
			            DriverScaled * [DriverWeight]
			    )
			
			RETURN
			    WeightedResult
			```
		lineageTag: 2f85aee6-5b0c-4d29-a9cd-605e504afd4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity Scaled FTE GL + Eff' = ```
			
			VAR MonthCount = DISTINCTCOUNT('DateTable'[YearMonth])
			VAR VacancyRate = 0.087
			VAR Efficiency =
			    CALCULATE(
			        MAX(Efficiency_Rates[Efficiency]),
			        Efficiency_Rates[LY Year] = YEAR(TODAY()) - 1
			    )
			
			VAR DriverTable =
			    ADDCOLUMNS(
			        VALUES(Fact_Actuals[Driver Name]),
			        "DriverWeight",
			            LOOKUPVALUE(
			                BaseProcessWeights[Weight],
			                BaseProcessWeights[SubStream], MAX(Fact_Actuals[Substream Abbreviation]),
			                BaseProcessWeights[Driver], [Driver Name]
			            ) / 100
			    )
			
			VAR WeightedResult =
			    SUMX(
			        DriverTable,
			        VAR LYTotalDriver =
			            CALCULATE(
			                [Total Driver new],
			                'DateTable'[Year] = YEAR(TODAY()) - 1,
			                ALL('DateTable')
			            )
			        VAR LYFTEAvg = 
			            CALCULATE(
			                [Active FTE Avg],
			                'DateTable'[Year] = YEAR(TODAY()) - 1,
			                ALL('DateTable')
			            )
			        VAR Baseline =
			            DIVIDE(
			                LYTotalDriver,
			                LYFTEAvg * (1 + VacancyRate)
			            )
			        VAR AdjustedBaseline =
			            IF(
			                MonthCount = 1,
			                Baseline / 12,
			                Baseline
			            )
			        VAR DriverScaled =
			            DIVIDE(
			                CALCULATE([Total Driver new]),
			                AdjustedBaseline * (1 + Efficiency)
			            )
			        RETURN
			            DriverScaled * [DriverWeight]
			    )
			
			RETURN
			    WeightedResult
			```
		lineageTag: 3d976f05-e821-4e03-a32f-458eafca90b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

