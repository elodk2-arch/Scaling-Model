	measure 'Actuals until: Month Year (Dynamic)' = ```
			
			VAR LatestActualDate =
			    CALCULATE(
			        MAX('Driver Data'[Reporting Date]),
			        FILTER(
			            ALL('Driver Data'),
			            'Driver Data'[Value] <> 0
			        )
			    )
			
			VAR AdjustedDate =
			    IF(
			        MONTH(LatestActualDate) = 12,
			        EOMONTH(TODAY(), -1),  // fallback to last completed month
			        LatestActualDate
			    )
			
			RETURN
			IF(
			    ISBLANK(LatestActualDate),
			    "Actuals until: No data :(",
			    "Latest Reported Data: " & FORMAT(AdjustedDate, "MMMM YYYY")
			)
			
			```
		lineageTag: 93e728ab-ed8a-42a5-8fda-e3be1b20c825

	measure 'Actual vs Forecast + Blue Special (Dynamic)' = ```
			
			VAR CurrentYMText = SELECTEDVALUE('DateTable'[YearMonth])
			VAR SelectedMeasure = SELECTEDVALUE('Stream split main'[MeasureName])
			
			VAR IsForecast = 
			    CALCULATE(
			        COUNTROWS(Fact_Actuals),
			        Fact_Actuals[IsForecast] = TRUE()
			    ) > 0
			
			RETURN
			IF(
			    ISBLANK(CurrentYMText),
			    BLANK(),
			    SWITCH(
			        TRUE(),
			
			        // Activity Scaled + 5% → Blue
			        SelectedMeasure = "Activity Scaled FTE + 5%", 5,
			
			        // Activity Scaled → Light Blue
			        SelectedMeasure = "Activity Scaled FTE", 6,
			
			        // Total Driver → Dark Green (actual) or Yellow (forecast)
			        SelectedMeasure = "Total Driver",
			            IF(IsForecast, 3, 1),
			
			        // Manual/Auto Driver → Light Green (actual) or Light Yellow (forecast)
			        SelectedMeasure IN {"Manual Driver", "Automated Driver"},
			            IF(IsForecast, 4, 2),
			
			        // Everything else → White
			        7
			    )
			)
			```
		formatString: 0
		lineageTag: 0d5ab920-5be1-4f77-a71b-2ea0a568b27d

