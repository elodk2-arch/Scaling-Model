	partition Fact_FTE = m
		mode: import
		source = ```
				let
				    Source = #"FTE Data",
				    
				    // ─────────────────────────────────────────────
				    // STEP 1: Active FTEs only
				    // ─────────────────────────────────────────────
				    ActiveOnly = Table.SelectRows(Source, each [Active] = 1),
				    
				    // ─────────────────────────────────────────────
				    // STEP 2: Join FTE Map
				    // ─────────────────────────────────────────────
				    Joined = Table.NestedJoin(
				        ActiveOnly, {"FTE Category ID"},
				        #"FTE Map", {"FTE Category ID"},
				        "MapData",
				        JoinKind.Inner
				    ),
				    
				    Expanded = Table.ExpandTableColumn(
				        Joined, "MapData",
				        {"FTE Category Name", "FTE Category Type", "FTE Family", "Stream Abbreviation", "Substream Abbreviation", "Functional Domain"},
				        {"FTE Category Name", "FTE Category Type", "FTE Family", "Stream Abbreviation", "Substream Abbreviation", "Functional Domain"}
				    ),
				    
				    // ─────────────────────────────────────────────
				    // STEP 3: Aggregate to monthly grain
				    // ─────────────────────────────────────────────
				    AggregatedActuals = Table.Group(
				        Expanded,
				        {"Date", "Stream Abbreviation", "Substream Abbreviation", "FTE Family", "FTE Category Type", "Functional Domain"},
				        {{"Active FTE", each List.Sum([Mapped FTE]), type number}}
				    ),
				    // Normalize actual dates to end of month to match forecast dates
				NormalizeActualDates = Table.TransformColumns(
				    AggregatedActuals,
				    {{"Date", each Date.EndOfMonth(_), type date}}
				),
				    
				    ActualsClean = Table.SelectRows(NormalizeActualDates, 
				    each [Active FTE] <> null and [Active FTE] <> 0
				),
				    AddIsForecastActuals = Table.AddColumn(ActualsClean, "IsForecast", each false, type logical),
				    
				    // ─────────────────────────────────────────────
				    // STEP 4: For each combo, find its latest row
				    // ─────────────────────────────────────────────
				    
				    // Sort by date descending so first row per group = latest
				    SortedDesc = Table.Sort(ActualsClean, {{"Date", Order.Descending}}),
				    
				    // Group by combo and take the first (latest) row
				    LatestPerCombo = Table.Group(
				        SortedDesc,
				        {"Stream Abbreviation", "Substream Abbreviation", "FTE Family", "FTE Category Type", "Functional Domain"},
				        {
				            {"LatestDate", each List.Max([Date]), type date},
				            {"LatestFTE", each 
				                let firstRow = Table.First(_) 
				                in firstRow[Active FTE], 
				                type number}
				        }
				    ),
				    
				    // ─────────────────────────────────────────────
				    // STEP 5: Generate forecast rows (held flat from latest)
				    // ─────────────────────────────────────────────
				    AddForecastMonths = Table.AddColumn(
				        LatestPerCombo, "ForecastMonths",
				        each
				            let
				                cutoff = [LatestDate],
				                startDate = Date.AddMonths(Date.EndOfMonth(cutoff), 1),
				                endDate = #date(Date.Year(cutoff), 12, 31),
				                monthCount = if startDate > endDate then 0 
				                             else (Date.Year(endDate) - Date.Year(startDate)) * 12 
				                                  + (Date.Month(endDate) - Date.Month(startDate)) + 1
				            in
				                if monthCount = 0 then {}
				                else List.Transform(
				                    {0..monthCount-1},
				                    each Date.EndOfMonth(Date.AddMonths(startDate, _))
				                )
				    ),
				    
				    ExpandedForecastMonths = Table.ExpandListColumn(AddForecastMonths, "ForecastMonths"),
				    FilterValidForecast = Table.SelectRows(ExpandedForecastMonths, each [ForecastMonths] <> null),
				    
				    // Shape forecast rows to match actuals schema
				    ForecastRenamed = Table.RenameColumns(FilterValidForecast, {
				        {"ForecastMonths", "Date"},
				        {"LatestFTE", "Active FTE"}
				    }),
				    AddIsForecastFlag = Table.AddColumn(ForecastRenamed, "IsForecast", each true, type logical),
				    
				    ForecastShaped = Table.SelectColumns(AddIsForecastFlag,
				        {"Date", "Stream Abbreviation", "Substream Abbreviation", 
				         "FTE Family", "FTE Category Type", "Functional Domain", 
				         "Active FTE", "IsForecast"}
				    ),
				    
				    // ─────────────────────────────────────────────
				    // STEP 6: Combine
				    // ─────────────────────────────────────────────
				    Combined = Table.Combine({AddIsForecastActuals, ForecastShaped}),
				    
				    AddYearMonth = Table.AddColumn(
				        Combined, "YearMonth",
				        each Date.ToText([Date], "yyyy-MM"),
				        type text
				    ),
				    #"Changed Type" = Table.TransformColumnTypes(AddYearMonth,{{"Date", type datetime}})
				in
				    #"Changed Type"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

