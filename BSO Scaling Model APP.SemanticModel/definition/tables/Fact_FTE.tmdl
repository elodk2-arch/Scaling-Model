	measure 'SDA Stream % of Total' =
			
			VAR CurrentStream = [SDA KPI FTEs Absorbed]
			VAR GrandTotal =
			    CALCULATE(
			        [SDA KPI FTEs Absorbed],
			        ALL('Sub_stream_combiner')
			    )
			VAR StreamPercentage = DIVIDE(CurrentStream, GrandTotal) * 100
			RETURN
			FORMAT(StreamPercentage, "0") & "%"
