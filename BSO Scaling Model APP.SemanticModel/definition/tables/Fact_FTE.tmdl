	measure 'SDA LY Volume per FTE' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year], YEAR(TODAY()))
			VAR LYDriver = 
			    CALCULATE(
			        [SDA Driver Switch],
			        'DateTable'[Year] = SelectedYear - 1,
			        ALL('DateTable')
			    )
			VAR LYAvgFTE = 
			    CALCULATE(
			        [SDA FTE Switch Weighted],
			        'DateTable'[Year] = SelectedYear - 1,
			        ALL('DateTable')
			    )
			RETURN
			DIVIDE(LYDriver, LYAvgFTE)
