	partition 'Stream split Year' = calculated
		mode: import
		source =
				
				DATATABLE(
				    "MeasureName", STRING,
				    "SortOrder", INTEGER,
				    {
				        {"Total Driver", 1},
				        {"Automated Driver", 3},
				        {"Manual Driver", 2},
				        {"Manual Ratio", 4},
				        {"Total Driver - Last Year SM", 5},
				        {"Manual / FTE (actuals)", 7},
