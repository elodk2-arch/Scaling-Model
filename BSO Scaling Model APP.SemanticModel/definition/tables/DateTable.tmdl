	column Year
		formatString: 0
		lineageTag: 870f3701-d9cd-4ded-b8d9-057e1684d118
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column MonthNumber
		formatString: 0
		lineageTag: 55eeaa51-852d-4da9-b5e1-b0b012851a4c
		summarizeBy: sum
		isNameInferred
		sourceColumn: [MonthNumber]

		annotation SummarizationSetBy = Automatic

	column MonthName
		lineageTag: 8f8a2000-38da-432b-9c44-33b78277c025
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthName]

