table Fact_Headcount
	lineageTag: 24707bf0-4e4e-405d-8a8f-ddb2b76b863b

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 6341d8f1-9e8d-40b0-a8cd-a72f2e360efd
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column MonthNumber
		dataType: int64
		formatString: 0
		lineageTag: f87f7f64-e360-451f-9f08-c72bd97303f6
		summarizeBy: sum
		sourceColumn: MonthNumber

		annotation SummarizationSetBy = Automatic

	column Headcount
		dataType: int64
		lineageTag: b5d04919-a78a-43b0-8d87-07016a9df40f
		summarizeBy: sum
		sourceColumn: Headcount

