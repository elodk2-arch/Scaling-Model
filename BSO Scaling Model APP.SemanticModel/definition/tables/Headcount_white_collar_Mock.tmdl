table Headcount_white_collar_Mock
	lineageTag: 815f45d6-3cb1-43c3-9c70-76a7b6f59a69

	measure 'White HC Forecast Dynamic' = ```
			
			VAR CurrentYear =
			    MAX('DateTable'[Year])
			
			VAR CurrentMonth =
			    MAX('DateTable'[MonthNumber])
			
			VAR ActualValue =
			    CALCULATE(
			        MAX(Headcount_white_collar_Mock[WhiteCollarHC]),
			        Headcount_White_Collar_Mock[Year] = CurrentYear,
			        Headcount_White_Collar_Mock[MonthNumber] = CurrentMonth
			    )
			
			VAR LastActualMonth =
			    CALCULATE(
			        MAX(Headcount_White_Collar_Mock[MonthNumber]),
			        FILTER(
			            ALL(Headcount_White_Collar_Mock),
			            Headcount_White_Collar_Mock[Year] = CurrentYear &&
			            Headcount_White_Collar_Mock[MonthNumber] < 12 &&
			            NOT ISBLANK(Headcount_White_Collar_Mock[WhiteCollarHC])
			        )
			    )
			
			VAR LastActualValue =
			    CALCULATE(
			        MAX(Headcount_White_Collar_Mock[WhiteCollarHC]),
			        Headcount_White_Collar_Mock[Year] = CurrentYear,
			        Headcount_White_Collar_Mock[MonthNumber] = LastActualMonth
			    )
			
			VAR DecemberTarget =
			    CALCULATE(
			        MAX(Headcount_White_Collar_Mock[WhiteCollarHC]),
			        Headcount_White_Collar_Mock[Year] = CurrentYear,
			        Headcount_White_Collar_Mock[MonthNumber] = 12
			    )
			
			VAR RemainingMonths =
			    12 - LastActualMonth
			
			VAR MonthlyIncrease =
			    DIVIDE(
			        DecemberTarget - LastActualValue,
			        RemainingMonths
			    )
			
			VAR ForecastValue =
			    LastActualValue +
			    (CurrentMonth - LastActualMonth) * MonthlyIncrease
			
			RETURN
			IF(
			    NOT ISBLANK(ActualValue) && CurrentMonth <= LastActualMonth,
			    ActualValue,
			    IF(
			        CurrentMonth > LastActualMonth,
			        ForecastValue
			    )
			)
			
			```
		lineageTag: e917a97d-1fe3-4be5-8b42-c9fe6fd058f0

