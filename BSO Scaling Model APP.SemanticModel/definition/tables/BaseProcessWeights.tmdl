table BaseProcessWeights
	lineageTag: e0b922f8-7680-4f7e-a69e-69d053ad95a4

	measure 'SubStream Weight (Text)' = ```
			
			VAR CurrentSubStream =
			    SELECTEDVALUE('FTE Map'[Substream Abbreviation])
			VAR W =
			    CALCULATE(
			        SELECTEDVALUE(BaseProcessWeights[Weight]),
			        BaseProcessWeights[SubStream] = CurrentSubStream
			    )
			RETURN
			CurrentSubStream & " Weight is: " & FORMAT(W, "0") & "%"
			
			```
		lineageTag: 1a6cbe0d-f60f-4a03-9fc9-36d597545872

	measure 'Weight %' = ```
			
			DIVIDE (
			    SELECTEDVALUE ( BaseProcessWeights[Weight] ),
			    100
			)
			
			```
		lineageTag: 6674f445-06ce-44e8-86d8-7e03515a360c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

