table Fact_Actuals
	lineageTag: c7a72712-bef8-4ddf-a2af-9908ccf99de6

	measure 'Total Driver new' =
			
			VAR Sub = MAX(Fact_Actuals[Substream Abbreviation])
			VAR DriverName = MAX(Fact_Actuals[Driver Name])
			
			RETURN
			IF(
			    Sub = "PC",
			    [Manual Driver new],
			    IF(
			        Sub = "TEM",
			        CALCULATE(
			            SUM(Fact_Actuals[Value]),
			            Fact_Actuals[Version] IN {"Manual", "Auto"}
			        ),
			        IF(
			            Sub = "RS" && CONTAINSSTRING(DriverName, "Interview"),
			            CALCULATE(
			                SUM(Fact_Actuals[Value]),
			                Fact_Actuals[Version] IN {"Manual", "Auto"}
			            ),
			            CALCULATE(
			                SUM(Fact_Actuals[Value]),
			                Fact_Actuals[Version] = "Total"
			            )
			        )
			    )
			)
		lineageTag: 237d6ad5-128c-48c4-b65c-562821f22539

		annotation PBI_FormatHint = {"isGeneralNumber":true}

