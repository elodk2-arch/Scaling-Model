	measure 'TAX Last12 Deduped' = ```
			
			VAR Cutoff = 
			    CALCULATE(
			        MAX(Fact_Actuals[Reporting Date]),
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Version] = "Total",
			        Fact_Actuals[Substream Abbreviation] = "TAX"
			    )
			VAR L12Start = EOMONTH(EDATE(Cutoff, -11), 0)
			VAR L12End = Cutoff
			RETURN
			    CALCULATE(
			        SUMX(
			            VALUES(Fact_Actuals[Driver Name]),
			            CALCULATE(
			                AVERAGEX(
			                    VALUES('DateTable'[YearMonth]),
			                    SUM(Fact_Actuals[Value])
			                )
			            )
			        ),
			        Fact_Actuals[Version] = "Total",
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Reporting Date] >= L12Start,
			        Fact_Actuals[Reporting Date] <= L12End,
			        Fact_Actuals[Substream Abbreviation] = "TAX"
			    )
