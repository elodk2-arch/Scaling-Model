	measure 'Total Forecast Driver' = ```
			
			VAR CurrentYear = MAX('DateTable'[Year])
			VAR CurrentMonth = MAX('DateTable'[MonthNumber])
			
			VAR HeadcountThisMonth = [Headcount Forecast Dynamic]
			
			VAR AvgRatioTotal = 
			    AVERAGEX(
			        FILTER(
			            'Fact_Actuals',
			            'Fact_Actuals'[Version] = "Total" &&
			            'Fact_Actuals'[Reporting Date] <= EOMONTH(TODAY(), -1)
			        ),
			        DIVIDE(
			            'Fact_Actuals'[Value], 
			            HeadcountThisMonth
			        )
			    )
			
			VAR ForecastValueTotal = HeadcountThisMonth * AvgRatioTotal
			
			RETURN
			    IF(
			        NOT ISBLANK(HeadcountThisMonth) && CurrentMonth,
			        HeadcountThisMonth,
			        ForecastValueTotal
			    )
			```
		lineageTag: 47dd69a2-90a1-4a53-af0c-a2422702523e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Activity Scaled FTE' = ```
			
			AVERAGEX(
			    VALUES('DateTable'[YearMonth]),
			    SUMX(
			        VALUES(Fact_Actuals[Driver Name]),
			        VAR DriverManual = 
			            CALCULATE(
			                [Manual Driver new],
			                Fact_Actuals[Driver Name] = EARLIER(Fact_Actuals[Driver Name])
			            )
			        VAR DriverCapacity = 
			            CALCULATE(
			                AVERAGE(Fact_Actuals[Manual per FTE Avg LY]),
			                Fact_Actuals[Driver Name] = EARLIER(Fact_Actuals[Driver Name])
			            )
			        VAR DriverWeight = 
			            LOOKUPVALUE(
			                BaseProcessWeights[Weight],
			                BaseProcessWeights[SubStream], MAX(Fact_Actuals[Substream Abbreviation]),
			                BaseProcessWeights[Driver], Fact_Actuals[Driver Name]
			            )
			        RETURN
			            DIVIDE(DriverManual, DriverCapacity) * DIVIDE(DriverWeight, 100)
			    )
			)
			```
		lineageTag: faba1382-8919-4ecd-9edd-61b477fbf985

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Manual per FTE Last year' = ```
			
			VAR MonthCount = DISTINCTCOUNT('DateTable'[YearMonth])
			VAR LYBaseline = 
			    CALCULATE(
			        SUMX(
			            VALUES('DateTable'[Year]),
			            DIVIDE([Manual Driver new], [Active FTE Avg])
			        ),
			        'DateTable'[Year] = YEAR(TODAY()) - 1,
			        ALL('DateTable')
			    )
			RETURN
			    IF(
			        MonthCount = 1,
			        LYBaseline / 12,
			        LYBaseline
			    )
			```
		lineageTag: 8bb242ca-4dd8-46ae-bcc6-9424d251f52b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity Scaled FTE HC Avg' = ```
			
			VAR MonthCount = DISTINCTCOUNT('DateTable'[YearMonth])
			VAR Baseline = AVERAGE('Fact_Actuals'[Manual per FTE LY Baseline])
			VAR AdjustedBaseline = 
			    IF(
			        MonthCount = 1,
			        Baseline / 12,  -- monthly view
			        Baseline        -- full year or multi-month view
			    )
			RETURN
			DIVIDE(
			    [Manual Driver new],
			    AdjustedBaseline
			)
			```
		lineageTag: 238d4934-f952-4afe-9c58-becadafde991

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity Scaled FTE AVG' =
			
			VAR MonthCount = DISTINCTCOUNT('DateTable'[YearMonth])
			
			VAR DriverTable =
			    ADDCOLUMNS(
			        VALUES(Fact_Actuals[Driver Name]),
			        "DriverWeight",
			            LOOKUPVALUE(
			                BaseProcessWeights[Weight],
			                BaseProcessWeights[SubStream], MAX(Fact_Actuals[Substream Abbreviation]),
			                BaseProcessWeights[Driver], [Driver Name]
			            ) / 100,
			        "DriverManual",
			            CALCULATE([Manual Driver new]),
			        "DriverLYBaseline",
			            CALCULATE(
			                SUMX(
			                    VALUES('DateTable'[Year]),
			                    DIVIDE([Manual Driver new], [Active FTE Avg])
			                ),
			                'DateTable'[Year] = YEAR(TODAY()) - 1,
			                ALL('DateTable')
			            )
			    )
			
			VAR WeightedResult =
			    SUMX(
			        DriverTable,
			        VAR AdjustedBaseline =
			            IF(
			                MonthCount = 1,
			                [DriverLYBaseline] / 12,
			                [DriverLYBaseline]
			            )
			        RETURN
			            DIVIDE([DriverManual], AdjustedBaseline) * [DriverWeight]
			    )
			
			RETURN
			    WeightedResult
		lineageTag: 0f531f1e-77a8-4e48-9481-46152409f349

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Activity Scaled FTE AVG + Eff' = ```
			
			VAR MonthCount = DISTINCTCOUNT('DateTable'[YearMonth])
			VAR Efficiency = 
			    CALCULATE(
			        MAX(Efficiency_Rates[Efficiency]),
			        Efficiency_Rates[LY Year] = YEAR(TODAY()) - 1
			    )
			
			VAR DriverTable =
			    ADDCOLUMNS(
			        VALUES(Fact_Actuals[Driver Name]),
			        "DriverWeight",
			            LOOKUPVALUE(
			                BaseProcessWeights[Weight],
			                BaseProcessWeights[SubStream], MAX(Fact_Actuals[Substream Abbreviation]),
			                BaseProcessWeights[Driver], [Driver Name]
			            ) / 100,
			        "DriverManual",
			            CALCULATE([Manual Driver new]),
			        "DriverLYBaseline",
			            CALCULATE(
			                SUMX(
			                    VALUES('DateTable'[Year]),
			                    DIVIDE([Manual Driver new], [Active FTE Avg])
			                ),
			                'DateTable'[Year] = YEAR(TODAY()) - 1,
			                ALL('DateTable')
			            )
			    )
			
			VAR WeightedResult =
			    SUMX(
			        DriverTable,
			        VAR AdjustedBaseline =
			            IF(
			                MonthCount = 1,
			                [DriverLYBaseline] / 12,
			                [DriverLYBaseline]
			            )
			        RETURN
			            DIVIDE(
			                [DriverManual],
			                AdjustedBaseline * (1 + Efficiency)
			            ) * [DriverWeight]
			    )
			
			RETURN
			    WeightedResult
			```
		lineageTag: a7a0877e-7c71-455b-9752-7596e46d889c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'GrowthDebug Last12' = ```
			
			VAR Sub = MAX(Fact_Actuals[Substream Abbreviation])
			VAR Cutoff = 
			    CALCULATE(
			        MAX(Fact_Actuals[Reporting Date]),
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Version] = "Total"
			    )
			VAR L12Start = EOMONTH(EDATE(Cutoff, -11), 0)
			VAR L12End = Cutoff
			RETURN
			    CALCULATE(
			        SUM(Fact_Actuals[Value]),
			        Fact_Actuals[Version] = "Total",
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Reporting Date] >= L12Start,
			        Fact_Actuals[Reporting Date] <= L12End
			    )
			```
		lineageTag: 9fd8f9c1-edca-4818-8011-4fec1b4ca678

