	measure 'Selected Measure' =
			
			VAR SelectedStream = SELECTEDVALUE('Stream split main'[Applicable Substreams])
			RETURN
			    SWITCH(
			        TRUE(),
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Total Driver", [Total Driver new],
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Manual Driver", [Manual Driver new],
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Automated Driver", [Automated Driver],
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Manual Ratio", [Manual %],
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Total Driver - Last Year SM", [Total Driver - Last Year SM],
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "FTE Actuals", [Active FTE new],
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Activity Scaled FTE", [Activity Scaled FTE],
			        SelectedStream = "CAS" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Activity Scaled FTE + Eff", [Activity Scaled FTE + Eff],
			        SelectedStream = "EMD" && SELECTEDVALUE('Stream split main'[MeasureName]) = "No. of driver / Total Headcount", [Driver per Headcount],
			        SelectedStream = "EMD" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Total Headcount", [Total Headcount Dynamic],
			        SelectedStream = "EMD" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Driver per FTE", [Manual Driver / FTE],
			        SelectedStream = "EMD" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Vacancy Positions", [Absorption %],
			        SelectedStream = "EMD" && SELECTEDVALUE('Stream split main'[MeasureName]) = "Activated Recruitments", [Total Activated Recruitments],
			        BLANK()  // Default case if no match
			    )
		lineageTag: 01169e53-54b3-4225-a970-dd4c37091373

