	column 'TEM Forecast Total' =
			
			VAR LastActualMonth =
			    CALCULATE(
			        MAX('DateTable'[MonthNumber]),
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Substream Abbreviation] = "TEM",
			        ALL('DateTable')
			    )
			
			VAR CurrentMonth = MAX('DateTable'[MonthNumber])
			VAR CurrentYear = MAX('DateTable'[Year])
			
			// Expanding avg of Total Driver / White Collar HC for actual months
			VAR ExpandingAvg =
			    AVERAGEX(
			        FILTER(
			            ALL('DateTable'),
			            'DateTable'[Year] = CurrentYear &&
			            'DateTable'[MonthNumber] <= LastActualMonth
			        ),
			        DIVIDE(
			            CALCULATE(
			                [Total Driver new],
			                Fact_Actuals[Version] = "Total",
			                Fact_Actuals[Substream Abbreviation] = "TEM"
			            ),
			            CALCULATE(
			                MAX(Headcount_White_Collar_Mock[WhiteCollarHC]),
			                Headcount_White_Collar_Mock[Year] = CurrentYear
			            )
			        )
			    )
			
			// Manual ratio from last actual month
			VAR LastManual =
			    CALCULATE(
			        [Manual Driver new],
			        'DateTable'[MonthNumber] = LastActualMonth,
			        'DateTable'[Year] = CurrentYear,
			        Fact_Actuals[Substream Abbreviation] = "TEM"
			    )
			
			VAR LastTotal =
			    CALCULATE(
			        [Total Driver new],
			        Fact_Actuals[Version] = "Total",
			        'DateTable'[MonthNumber] = LastActualMonth,
			        'DateTable'[Year] = CurrentYear,
			        Fact_Actuals[Substream Abbreviation] = "TEM"
			    )
			
			VAR ManualRatio = DIVIDE(LastManual, LastTotal)
			
			// White collar HC for forecast month
			VAR WhiteHC = [White HC Forecast Dynamic]
			
			VAR ForecastTotal = WhiteHC * ExpandingAvg * ManualRatio
			
			RETURN
			IF(
			    CurrentMonth > LastActualMonth,
			    ForecastTotal,
			    [Total Driver new]
			)
		lineageTag: 7fb014bb-a5bc-45ee-b06d-4a31cd14f744
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Fact_Actuals = m
		mode: import
		source = ```
				let
				    Source = #"Driver Data",
				    
				    Joined = Table.NestedJoin(
				        Source, {"Driver ID"},
				        #"Driver Map", {"Driver ID"},
				        "MapData",
				        JoinKind.Inner
				    ),
				    
				    Expanded = Table.ExpandTableColumn(
				        Joined, "MapData",
				        {"Version", "Driver Name", "Driver Family", "Service Region", "Stream Abbreviation", "Substream Abbreviation", "Weight"},
				        {"Version", "Driver Name", "Driver Family", "Service Region", "Stream Abbreviation", "Substream Abbreviation", "Weight"}
				    ),
				    
				    TodayCutoff = Date.EndOfMonth(Date.AddMonths(DateTime.Date(DateTime.LocalNow()), -1)),
				    
				    ExpandedFiltered = Table.SelectRows(Expanded, each [Reporting Date] <= TodayCutoff),
				    
				    SubstreamCutoffs = 
				        Table.Group(
				            Table.SelectRows(ExpandedFiltered, each [Version] = "Total" and [Value] <> null and [Value] <> 0),
				            {"Substream Abbreviation"},
				            {{"SubLastDate", each Date.EndOfMonth(List.Max([Reporting Date])), type date}}
				        ),
				    SubstreamCutoffRecord = Record.FromList(
				        SubstreamCutoffs[SubLastDate],
				        SubstreamCutoffs[#"Substream Abbreviation"]
				    ),
				    
				    ActualsClean = Table.Buffer(
				        Table.SelectRows(
				            ExpandedFiltered,
				            each
				                let
				                    sub = [Substream Abbreviation],
				                    cutoff = Record.FieldOrDefault(SubstreamCutoffRecord, sub, TodayCutoff)
				                in
				                    [Reporting Date] <= cutoff
				        )
				    ),
				    AddIsForecastActuals = Table.AddColumn(ActualsClean, "IsForecast", each false, type logical),
				    
				    // NOTE: this is the RAW Version="Total"-only table, kept around as TotalOnly1
				    // so the name doesn't collide with the substream-aware TotalOnly built below.
				    TotalOnly1 = Table.Buffer(
				        Table.Group(
				            Table.SelectRows(ActualsClean, each [Version] = "Total"),
				            {"Substream Abbreviation", "Driver Name", "Reporting Date"},
				            {{"Value", each List.Sum([Value]), type number}}
				        )
				    ),
				    // FIX: SubstreamList is defined ONCE here. (It was previously also redefined
				    // inside the Step C block below, which is a duplicate-identifier error that
				    // stops the whole query from compiling.)
				    SubstreamList = List.Distinct(SubstreamCutoffs[#"Substream Abbreviation"]),
				
				    // ─────────────────────────────────────────────
				    // STEP C: Growth calculation
				    // Uses the same version logic as [Total Driver new]
				    // PC                    → Manual
				    // TEM                   → Manual + Auto
				    // RS + Interview        → Manual + Auto
				    // Everything else       → Total
				    // ─────────────────────────────────────────────
				
				   GrowthBase = Table.SelectRows(
				    ActualsClean,
				    each
				        [Value] <> null
				        and [Value] <> 0
				        and
				        (
				            // PC → Manual only
				            ([Substream Abbreviation] = "PC"
				                and [Version] = "Manual")
				
				            // TEM → Manual + Auto
				            or (
				                [Substream Abbreviation] = "TEM"
				                and ([Version] = "Manual" or [Version] = "Auto")
				            )
				
				            // RS Interviews → Manual + Auto
				            or (
				                [Substream Abbreviation] = "RS"
				                and Text.Contains(Text.Lower([Driver Name]), "interview")
				                and ([Version] = "Manual" or [Version] = "Auto")
				            )
				
				            // All other drivers → Total only
				            or (
				                [Substream Abbreviation] <> "PC"
				                and [Substream Abbreviation] <> "TEM"
				                and [Version] = "Total"
				            )
				        )
				),
				    // Combine versions where Manual + Auto are required.
				    // For PC only Manual is included.
				    // For normal drivers only Total is included.
				    TotalOnly = Table.Buffer(
				        Table.Group(
				            GrowthBase,
				            {"Substream Abbreviation", "Driver Name", "Reporting Date"},
				            {{"Value", each List.Sum([Value]), type number}}
				        )
				    ),
				    DriverSubList = List.Distinct(
				        Table.ToRecords(
				            Table.SelectColumns(
				                TotalOnly,
				                {"Substream Abbreviation", "Driver Name"}
				            )
				        )
				    ),
				
				    GrowthPerDriver = List.Transform(
				        DriverSubList,
				        each
				            let
				                sub = _[#"Substream Abbreviation"],
				                driver = _[#"Driver Name"],
				
				                cutoff = Record.FieldOrDefault(
				                    SubstreamCutoffRecord,
				                    sub,
				                    null
				                ),
				
				                l12End = cutoff,
				                l12Start =
				                    if cutoff = null
				                    then null
				                    else Date.StartOfMonth(
				                        Date.AddMonths(cutoff, -11)
				                    ),
				
				                p12End =
				                    if cutoff = null
				                    then null
				                    else Date.EndOfMonth(
				                        Date.AddMonths(cutoff, -12)
				                    ),
				
				                p12Start =
				                    if cutoff = null
				                    then null
				                    else Date.StartOfMonth(
				                        Date.AddMonths(cutoff, -23)
				                    ),
				
				                // FIX: this was reading from TotalOnly1 (the old Version="Total"-only
				                // table), which meant the substream-aware GrowthBase/TotalOnly logic
				                // above was never actually used - growth was silently still computed
				                // the old way for every substream, including PC (which has no "Total"
				                // rows at all, so its growth rate always came back as 0).
				                streamRows = Table.SelectRows(
				                    TotalOnly,
				                    (r) =>
				                        r[#"Substream Abbreviation"] = sub
				                        and r[#"Driver Name"] = driver
				                ),
				
				                last12Sum =
				                    if cutoff = null
				                    then 0
				                    else
				                        List.Sum(
				                            Table.SelectRows(
				                                streamRows,
				                                (r) =>
				                                    r[Reporting Date] >= l12Start
				                                    and r[Reporting Date] <= l12End
				                            )[Value]
				                        ),
				
				                prev12Sum =
				                    if cutoff = null
				                    then 0
				                    else
				                        List.Sum(
				                            Table.SelectRows(
				                                streamRows,
				                                (r) =>
				                                    r[Reporting Date] >= p12Start
				                                    and r[Reporting Date] <= p12End
				                            )[Value]
				                        ),
				
				                rate =
				                    if prev12Sum = null or prev12Sum = 0
				                    then 0
				                    else (last12Sum / prev12Sum) - 1
				            in
				                rate
				    ),
				
				    GrowthRecord = Record.FromList(
				        GrowthPerDriver,
				        List.Transform(
				            DriverSubList,
				            each
				                _[#"Driver Name"]
				                & "||"
				                & _[#"Substream Abbreviation"]
				        )
				    ),
				    HeadcountLookup = Table.Buffer(
				        Table.SelectColumns(Fact_Headcount, {"Year", "MonthNumber", "Headcount"})
				    ),
				
				    WhiteCollarLookup = Table.Buffer(
				        Table.SelectColumns(Fact_WhiteCollarHC, {"Year", "MonthNumber", "WhiteCollarHC"})
				    ),
				
				    // ─────────────────────────────────────────────
				    // TEM: Expanding avg ratio
				    // ─────────────────────────────────────────────
				    TEMTotalActuals = Table.Buffer(
				        Table.SelectRows(
				            ActualsClean,
				            each [Value] <> null and [Value] <> 0
				                and [Substream Abbreviation] = "TEM"
				                and ([Version] = "Manual" or [Version] = "Auto")
				        )
				    ),
				
				    TEMTotalByMonth = Table.Group(
				        TEMTotalActuals,
				        {"Substream Abbreviation", "Reporting Date"},
				        {{"TotalValue", each List.Sum([Value]), type number}}
				    ),
				
				    AddTEMYear = Table.AddColumn(
				        Table.AddColumn(TEMTotalByMonth, "Year", each Date.Year([Reporting Date]), Int64.Type),
				        "MonthNumber", each Date.Month([Reporting Date]), Int64.Type
				    ),
				
				    JoinWhiteCollar = Table.NestedJoin(
				        AddTEMYear, {"Year", "MonthNumber"},
				        WhiteCollarLookup, {"Year", "MonthNumber"},
				        "WCData", JoinKind.LeftOuter
				    ),
				    ExpandWhiteCollar = Table.ExpandTableColumn(
				        JoinWhiteCollar, "WCData", {"WhiteCollarHC"}, {"WhiteCollarHC"}
				    ),
				
				    AddTEMRatio = Table.Buffer(
				        Table.AddColumn(
				            ExpandWhiteCollar, "TEMRatio",
				            each if [WhiteCollarHC] = null or [WhiteCollarHC] = 0 then null
				                 else [TotalValue] / [WhiteCollarHC],
				            type number
				        )
				    ),
				
				    TEMRatioNested =
				        let
				            byYear = Table.Group(
				                Table.SelectRows(AddTEMRatio, each [TEMRatio] <> null),
				                {"Substream Abbreviation", "Year"},
				                {{"MonthRatios", each
				                    List.Sort(
				                        Table.ToRecords(Table.SelectColumns(_, {"MonthNumber", "TEMRatio"})),
				                        each _[MonthNumber]
				                    )
				                }}
				            ),
				            bySubstream = Table.Group(
				                byYear,
				                {"Substream Abbreviation"},
				                {{"YearData", each
				                    Record.FromList(
				                        [MonthRatios],
				                        List.Transform([Year], each Number.ToText(_))
				                    )
				                }}
				            )
				        in
				            Record.FromList(bySubstream[YearData], bySubstream[#"Substream Abbreviation"]),
				
				    TEMCutoff = Record.FieldOrDefault(SubstreamCutoffRecord, "TEM", null),
				    TEMLastActualYear = if TEMCutoff = null then null else Date.Year(TEMCutoff),
				    TEMLastActualMonth = if TEMCutoff = null then null else Date.Month(TEMCutoff),
				
				    TEMLastTotal =
				        let
				            manualRows = Table.SelectRows(
				                ActualsClean,
				                each [Substream Abbreviation] = "TEM"
				                    and [Version] = "Manual"
				                    and Date.Year([Reporting Date]) = TEMLastActualYear
				                    and Date.Month([Reporting Date]) = TEMLastActualMonth
				            ),
				            autoRows = Table.SelectRows(
				                ActualsClean,
				                each [Substream Abbreviation] = "TEM"
				                    and [Version] = "Auto"
				                    and Date.Year([Reporting Date]) = TEMLastActualYear
				                    and Date.Month([Reporting Date]) = TEMLastActualMonth
				            )
				        in
				            List.Sum(manualRows[Value]) + List.Sum(autoRows[Value]),
				
				    TEMAutoActuals = Table.Buffer(
				        Table.SelectRows(ActualsClean, each [Version] = "Auto" and [Value] <> null and [Value] <> 0 and [Substream Abbreviation] = "TEM")
				    ),
				
				    TEMAutoByMonth = Table.Group(
				        TEMAutoActuals,
				        {"Substream Abbreviation", "Reporting Date"},
				        {{"AutoValue", each List.Sum([Value]), type number}}
				    ),
				
				    TEMLastAuto =
				        let
				            rows = Table.SelectRows(TEMAutoByMonth, (r) => Date.Year(r[Reporting Date]) = TEMLastActualYear and Date.Month(r[Reporting Date]) = TEMLastActualMonth)
				        in
				            if Table.RowCount(rows) = 0 then null else rows{0}[AutoValue],
				
				    TEMAutoRatio = if TEMLastTotal = null or TEMLastTotal = 0 then null else TEMLastAuto / TEMLastTotal,
				
				    TEMAutoSplit = Table.Buffer(
				        let
				            autoRows = Table.SelectRows(
				                ActualsClean,
				                each [Substream Abbreviation] = "TEM"
				                    and [Version] = "Auto"
				                    and Date.Year([Reporting Date]) = TEMLastActualYear
				                    and Date.Month([Reporting Date]) = TEMLastActualMonth
				            ),
				            byDriver = Table.Group(autoRows, {"Driver ID"}, {{"Value", each List.Sum([Value]), type number}}),
				            totalAuto = List.Sum(byDriver[Value]),
				            withRatio = Table.AddColumn(
				                byDriver, "AutoSplitRatio",
				                each if totalAuto = null or totalAuto = 0 then 0 else [Value] / totalAuto,
				                type number
				            )
				        in
				            withRatio
				    ),
				
				    TEMAutoSplitRecord = Record.FromList(
				        TEMAutoSplit[AutoSplitRatio],
				        List.Transform(TEMAutoSplit[Driver ID], each Text.From(_))
				    ),
				
				    // ─────────────────────────────────────────────
				    // RS: Lookup tables and helper functions
				    // ─────────────────────────────────────────────
				    RSActuals = Table.Buffer(
				        Table.SelectRows(ActualsClean, each [Substream Abbreviation] = "RS")
				    ),
				
				    RSCutoff = Record.FieldOrDefault(SubstreamCutoffRecord, "RS", null),
				    RSLastActualYear = if RSCutoff = null then null else Date.Year(RSCutoff),
				    RSLastActualMonth = if RSCutoff = null then null else Date.Month(RSCutoff),
				
				    RSTriggerData = Table.Buffer(
				        Table.SelectRows(Expanded, each [Substream Abbreviation] = "RS" and [Version] = "Trigger")
				    ),
				
				    // ─────────────────────────────────────────────
				    // RS: Pre-compute expanding avg ratios per region
				    // Stored as nested records for fast lookup in forecast rows
				    // ─────────────────────────────────────────────
				
				    // Get all actual months for RS up to cutoff
				    RSActualMonths = Table.Buffer(
				        Table.Distinct(
				            Table.SelectColumns(
				                Table.AddColumn(
				                    Table.AddColumn(RSActuals, "Year", each Date.Year([Reporting Date]), Int64.Type),
				                    "MonthNumber", each Date.Month([Reporting Date]), Int64.Type
				                ),
				                {"Service Region", "Year", "MonthNumber", "Reporting Date"}
				            )
				        )
				    ),
				
				    RSRegions = List.Distinct(RSActuals[Service Region]),
				
				    // Pre-compute per region: expanding avg resume ratio salaried
				    RSResumeSalariedRatiosByRegion = Record.FromList(
				        List.Transform(
				            RSRegions,
				            each
				                let
				                    region = _,
				                    // Get all actual months for this region sorted ascending
				                    regionMonths = List.Sort(
				                        List.Distinct(
				                            List.Transform(
				                                Table.ToRecords(
				                                    Table.SelectRows(RSActualMonths, (r) => Text.Lower(r[Service Region]) = Text.Lower(region))
				                                ),
				                                each [Reporting Date]
				                            )
				                        ),
				                        Order.Ascending
				                    ),
				                    // For each actual month compute the ratio
				                    ratiosByMonth = List.Transform(
				                        regionMonths,
				                        each
				                            let
				                                dt = _,
				                                numRows = Table.SelectRows(
				                                    RSActuals,
				                                    (r) => Text.Lower(r[#"Driver Name"]) = "resumes received - salaried + cse + executive"
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                denRows = Table.SelectRows(
				                                    RSTriggerData,
				                                    (r) => (Text.Contains(Text.Lower(r[#"Driver Name"]), "salaried + cse") or Text.Contains(Text.Lower(r[#"Driver Name"]), "executive"))
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                num = List.Sum(numRows[Value]),
				                                den = List.Sum(denRows[Value]),
				                                ratio = if den = null or den = 0 then null else num / den
				                            in
				                                [Date = dt, Ratio = ratio]
				                    ),
				                    // Filter nulls
				                    validRatios = List.Select(ratiosByMonth, each _[Ratio] <> null)
				                in
				                    validRatios
				        ),
				        RSRegions
				    ),
				
				    // Pre-compute per region: expanding avg resume ratio hourly
				    RSResumeHourlyRatiosByRegion = Record.FromList(
				        List.Transform(
				            RSRegions,
				            each
				                let
				                    region = _,
				                    regionMonths = List.Sort(
				                        List.Distinct(
				                            List.Transform(
				                                Table.ToRecords(
				                                    Table.SelectRows(RSActualMonths, (r) => Text.Lower(r[Service Region]) = Text.Lower(region))
				                                ),
				                                each [Reporting Date]
				                            )
				                        ),
				                        Order.Ascending
				                    ),
				                    ratiosByMonth = List.Transform(
				                        regionMonths,
				                        each
				                            let
				                                dt = _,
				                                numRows = Table.SelectRows(
				                                    RSActuals,
				                                    (r) => Text.Lower(r[#"Driver Name"]) = "resumes received - hourly"
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                denRows = Table.SelectRows(
				                                    RSTriggerData,
				                                    (r) => Text.Contains(Text.Lower(r[#"Driver Name"]), "hourly")
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                num = List.Sum(numRows[Value]),
				                                den = List.Sum(denRows[Value]),
				                                ratio = if den = null or den = 0 then null else num / den
				                            in
				                                [Date = dt, Ratio = ratio]
				                    ),
				                    validRatios = List.Select(ratiosByMonth, each _[Ratio] <> null)
				                in
				                    validRatios
				        ),
				        RSRegions
				    ),
				
				    // Pre-compute per region: expanding avg interview ratio (Interviews Salaried / Activated Salaried)
				    RSInterviewRatiosByRegion = Record.FromList(
				        List.Transform(
				            RSRegions,
				            each
				                let
				                    region = _,
				                    regionMonths = List.Sort(
				                        List.Distinct(
				                            List.Transform(
				                                Table.ToRecords(
				                                    Table.SelectRows(RSActualMonths, (r) => Text.Lower(r[Service Region]) = Text.Lower(region))
				                                ),
				                                each [Reporting Date]
				                            )
				                        ),
				                        Order.Ascending
				                    ),
				                    ratiosByMonth = List.Transform(
				                        regionMonths,
				                        each
				                            let
				                                dt = _,
				                                // Total interviews (Manual + Auto) Salaried+CSE
				                                numRows = Table.SelectRows(
				                                    RSActuals,
				                                    (r) => Text.Contains(Text.Lower(r[#"Driver Name"]), "interviews scheduled - salaried + cse")
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                denRows = Table.SelectRows(
				                                    RSTriggerData,
				                                    (r) => Text.Contains(Text.Lower(r[#"Driver Name"]), "salaried + cse")
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                num = List.Sum(numRows[Value]),
				                                den = List.Sum(denRows[Value]),
				                                ratio = if den = null or den = 0 then null else num / den
				                            in
				                                [Date = dt, Ratio = ratio]
				                    ),
				                    validRatios = List.Select(ratiosByMonth, each _[Ratio] <> null)
				                in
				                    validRatios
				        ),
				        RSRegions
				    ),
				
				    // Pre-compute per region: expanding avg manual rate (Manual Interviews / Total Interviews)
				    RSManualRateByRegion = Record.FromList(
				        List.Transform(
				            RSRegions,
				            each
				                let
				                    region = _,
				                    regionMonths = List.Sort(
				                        List.Distinct(
				                            List.Transform(
				                                Table.ToRecords(
				                                    Table.SelectRows(RSActualMonths, (r) => Text.Lower(r[Service Region]) = Text.Lower(region))
				                                ),
				                                each [Reporting Date]
				                            )
				                        ),
				                        Order.Ascending
				                    ),
				                    ratiosByMonth = List.Transform(
				                        regionMonths,
				                        each
				                            let
				                                dt = _,
				                                manualRows = Table.SelectRows(
				                                    RSActuals,
				                                    (r) => Text.Contains(Text.Lower(r[#"Driver Name"]), "interviews")
				                                        and Text.Lower(r[Version]) = "manual"
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                totalRows = Table.SelectRows(
				                                    RSActuals,
				                                    (r) => Text.Contains(Text.Lower(r[#"Driver Name"]), "interviews")
				                                        and (Text.Lower(r[Version]) = "manual" or Text.Lower(r[Version]) = "auto")
				                                        and Text.Lower(r[Service Region]) = Text.Lower(region)
				                                        and r[Reporting Date] = dt
				                                ),
				                                manualSum = List.Sum(manualRows[Value]),
				                                totalSum = List.Sum(totalRows[Value]),
				                                rate = if totalSum = null or totalSum = 0 then null else manualSum / totalSum
				                            in
				                                [Date = dt, Ratio = rate]
				                    ),
				                    validRatios = List.Select(ratiosByMonth, each _[Ratio] <> null)
				                in
				                    validRatios
				        ),
				        RSRegions
				    ),
				
				    // Helper: get expanding avg ratio up to (but not including) forecast date
				    GetExpandingAvg = (ratioList as list, forecastDate as date) as number =>
				        let
				            // Only use actual months before forecast date
				            priorRatios = List.Select(ratioList, each _[Date] < forecastDate),
				            ratioValues = List.Transform(priorRatios, each _[Ratio]),
				            // Jan fallback - use first available ratio if none prior
				            janRatio = if List.Count(ratioList) = 0 then 0
				                       else List.First(List.Transform(ratioList, each _[Ratio]))
				        in
				            if List.IsEmpty(ratioValues) then janRatio
				            else List.Average(ratioValues),
				
				    // Helper: get trigger value for a region and forecast date
				    GetTriggerValue = (driverNamePattern as text, region as text, forecastDate as date) as number =>
				        let
				            yr = Date.Year(forecastDate),
				            mth = Date.Month(forecastDate),
				            rows = Table.SelectRows(
				                RSTriggerData,
				                (r) => Text.Contains(Text.Lower(r[#"Driver Name"]), Text.Lower(driverNamePattern))
				                    and Text.Lower(r[#"Service Region"]) = Text.Lower(region)
				                    and Date.Year(r[Reporting Date]) = yr
				                    and Date.Month(r[Reporting Date]) = mth
				            )
				        in
				            if Table.RowCount(rows) = 0 then 0 else List.Sum(rows[Value]),
				
				    // ─────────────────────────────────────────────
				    // STEP D: Headcount lookup + ratios
				    // ─────────────────────────────────────────────
				    TotalActualsOnly = Table.SelectRows(
				        ActualsClean,
				        each [Version] = "Total" and [Value] <> null and [Value] <> 0
				    ),
				
				    AddYearMonth_Actuals = Table.AddColumn(
				        Table.AddColumn(TotalActualsOnly, "Year", each Date.Year([Reporting Date]), Int64.Type),
				        "MonthNumber", each Date.Month([Reporting Date]), Int64.Type
				    ),
				
				    JoinHC = Table.NestedJoin(
				        AddYearMonth_Actuals, {"Year", "MonthNumber"},
				        HeadcountLookup, {"Year", "MonthNumber"},
				        "HCData", JoinKind.LeftOuter
				    ),
				    ExpandHC = Table.ExpandTableColumn(JoinHC, "HCData", {"Headcount"}, {"Headcount"}),
				
				    AddRatio = Table.Buffer(
				        Table.AddColumn(
				            ExpandHC, "DriverHCRatio",
				            each if [Headcount] = null or [Headcount] = 0 then null
				                 else [Value] / [Headcount],
				            type number
				        )
				    ),
				
				    RatioPerDriverYearMonth = Table.Group(
				        Table.SelectRows(AddRatio, each [DriverHCRatio] <> null),
				        {"Driver ID", "Version", "Year", "MonthNumber"},
				        {{"DriverHCRatio", each List.Sum([DriverHCRatio]), type number}}
				    ),
				
				    ActualRatiosNested =
				        let
				            withKey = Table.AddColumn(
				                RatioPerDriverYearMonth, "DriverKey",
				                each Text.From([Driver ID]) & "||" & Text.From([Version])
				            ),
				            byDriver = Table.Group(
				                withKey,
				                {"DriverKey"},
				                {{"ByYear", each
				                    let
				                        innerTable = _,
				                        byYear = Table.Group(
				                            innerTable,
				                            {"Year"},
				                            {{"MonthRatios", each
				                                List.Sort(
				                                    Table.ToRecords(Table.SelectColumns(_, {"MonthNumber", "DriverHCRatio"})),
				                                    each _[MonthNumber]
				                                )
				                            }}
				                        )
				                    in
				                        Record.FromList(
				                            byYear[MonthRatios],
				                            List.Transform(byYear[Year], Number.ToText)
				                        )
				                }}
				            )
				        in
				            Record.FromList(byDriver[ByYear], byDriver[DriverKey]),
				
				    // ─────────────────────────────────────────────
				    // STEP D2: headcount_avg method
				    // ─────────────────────────────────────────────
				    DriverSubCombos = List.Distinct(
				        Table.ToRecords(
				            Table.SelectColumns(ActualsClean, {"Driver ID", "Substream Abbreviation"})
				        )
				    ),
				
				    LYDecHCPerSubstream = List.Transform(
				        SubstreamList,
				        each
				            let
				                sub = _,
				                cutoff = Record.Field(SubstreamCutoffRecord, sub),
				                lyYear = Date.Year(cutoff) - 1,
				                decRows = Table.SelectRows(HeadcountLookup, (r) => r[Year] = lyYear and r[MonthNumber] = 12),
				                decHC = if Table.RowCount(decRows) = 0 then null else decRows{0}[Headcount]
				            in
				                decHC
				    ),
				    LYDecHCRecord = Record.FromList(LYDecHCPerSubstream, SubstreamList),
				
				    LYDriverPerDriver = List.Transform(
				        DriverSubCombos,
				        each
				            let
				                driverID = _[Driver ID],
				                sub = _[#"Substream Abbreviation"],
				                cutoff = Record.FieldOrDefault(SubstreamCutoffRecord, sub, null),
				                lyYear = if cutoff = null then null else Date.Year(cutoff) - 1,
				                lyStart = if lyYear = null then null else #date(lyYear, 1, 1),
				                lyEnd = if lyYear = null then null else #date(lyYear, 12, 31),
				                streamRows = Table.SelectRows(
				                    ActualsClean,
				                    (r) => r[#"Driver ID"] = driverID
				                        and r[#"Substream Abbreviation"] = sub
				                        and r[#"Version"] = "Manual"
				                        and r[Reporting Date] >= lyStart
				                        and r[Reporting Date] <= lyEnd
				                ),
				                lyTotal = List.Sum(streamRows[Value])
				            in
				                [DriverKey = Text.From(driverID) & "||" & sub, LYTotal = lyTotal]
				    ),
				
				    HCAvgRatioPerDriver = List.Transform(
				        LYDriverPerDriver,
				        each
				            let
				                key = _[DriverKey],
				                sub = Text.Split(key, "||"){1},
				                lyDriver = _[LYTotal],
				                lyDecHC = Record.FieldOrDefault(LYDecHCRecord, sub, null)
				            in
				                [DriverKey = key, Ratio = if lyDriver = null or lyDecHC = null or lyDecHC = 0 then null else lyDriver / lyDecHC / 12]
				    ),
				    HCAvgRatioDriverRecord = Record.FromList(
				        List.Transform(HCAvgRatioPerDriver, each _[Ratio]),
				        List.Transform(HCAvgRatioPerDriver, each _[DriverKey])
				    ),
				
				    RegionCountPerDriver = Table.Buffer(
				        Table.Group(
				            Table.SelectRows(ActualsClean, each [Version] = "Manual"),
				            {"Driver ID", "Substream Abbreviation"},
				            {{"RegionCount", each List.Count(List.Distinct([Service Region])), type number}}
				        )
				    ),
				    RegionCountRecord = Record.FromList(
				        RegionCountPerDriver[RegionCount],
				        List.Transform(
				            Table.ToRecords(Table.SelectColumns(RegionCountPerDriver, {"Driver ID", "Substream Abbreviation"})),
				            each Text.From(_[Driver ID]) & "||" & _[#"Substream Abbreviation"]
				        )
				    ),
				
				    // ─────────────────────────────────────────────
				    // STEP E: Build LY lookup
				    // ─────────────────────────────────────────────
				    ActualsLookupBase = Table.AddColumn(
				        Table.AddColumn(ActualsClean, "LY_Year", each Date.Year([Reporting Date]), Int64.Type),
				        "LY_Month", each Date.Month([Reporting Date]), Int64.Type
				    ),
				    ActualsLookup = Table.Group(
				        ActualsLookupBase,
				        {"Driver ID", "Version", "LY_Year", "LY_Month"},
				        {{"LYValue", each List.Sum([Value]), type number}}
				    ),
				
				    // ─────────────────────────────────────────────
				    // STEP F: Enrich actuals
				    // ─────────────────────────────────────────────
				    AddActualsLYKeys = Table.AddColumn(
				        Table.AddColumn(AddIsForecastActuals, "LY_Year", each Date.Year([Reporting Date]) - 1, Int64.Type),
				        "LY_Month", each Date.Month([Reporting Date]), Int64.Type
				    ),
				
				    JoinLYActuals = Table.NestedJoin(
				        AddActualsLYKeys, {"Driver ID", "Version", "LY_Year", "LY_Month"},
				        ActualsLookup, {"Driver ID", "Version", "LY_Year", "LY_Month"},
				        "LYData", JoinKind.LeftOuter
				    ),
				    ExpandLYActuals = Table.ExpandTableColumn(JoinLYActuals, "LYData", {"LYValue"}, {"LY Same Month"}),
				
				    AddGrowthRateActuals = Table.AddColumn(
				        ExpandLYActuals, "Growth Rate",
				        each Record.FieldOrDefault(GrowthRecord, [Driver Name] & "||" & [Substream Abbreviation], 0),
				        type number
				    ),
				
				    ActualsEnriched = Table.RemoveColumns(AddGrowthRateActuals, {"LY_Year", "LY_Month"}),
				
				    // ─────────────────────────────────────────────
				    // STEP G: Load method lookup
				    // ─────────────────────────────────────────────
				    MethodRecord = Record.FromList(
				        Stream_Forecast_Method[#"Forecast Method"],
				        Stream_Forecast_Method[#"Substream Abbreviation"]
				    ),
				
				    // ─────────────────────────────────────────────
				    // STEP H: Generate forecast rows
				    // ─────────────────────────────────────────────
				    // FIX: reverted to keeping every Driver ID + Version combo as its own row
				    // (no Table.Group collapse, no per-substream hardcoding). This is what
				    // actually makes each driver family forecast independently - it's driven
				    // entirely by whatever versions exist in the real data, so it doesn't need
				    // special-casing for PC/TEM/RS and won't break the next time a new
				    // multi-version substream shows up.
				    DriverVersionCombos = 
				        Table.Distinct(
				            Table.SelectColumns(
				                Table.SelectRows(ActualsClean, each [Version] <> "Trigger"),
				                {
				                    "Driver ID", "Version", "Driver Name", "Driver Family",
				                    "Service Region", "Stream Abbreviation", "Substream Abbreviation", "Weight"
				                }
				            )
				        ),
				
				    AddForecastMonthsCol = Table.AddColumn(
				        DriverVersionCombos, "ForecastMonths",
				        each
				            let
				                sub = [Substream Abbreviation],
				                cutoff = Record.FieldOrDefault(SubstreamCutoffRecord, sub, null)
				            in
				                if cutoff = null then {}
				                else
				                    let
				                        startDate = Date.AddMonths(Date.EndOfMonth(cutoff), 1),
				                        endDate = #date(Date.Year(cutoff), 12, 31),
				                        monthCount = if startDate > endDate then 0
				                                     else (Date.Year(endDate) - Date.Year(startDate)) * 12
				                                          + (Date.Month(endDate) - Date.Month(startDate)) + 1
				                    in
				                        List.Transform(
				                            {0..monthCount-1},
				                            each Date.EndOfMonth(Date.AddMonths(startDate, _))
				                        )
				    ),
				    ExpandedMonths = Table.ExpandListColumn(AddForecastMonthsCol, "ForecastMonths"),
				    RenamedForecastMonth = Table.RenameColumns(ExpandedMonths, {{"ForecastMonths", "ForecastMonth"}}),
				    FilterValidForecast = Table.SelectRows(RenamedForecastMonth, each [ForecastMonth] <> null),
				
				    AddLYKeys = Table.AddColumn(
				        Table.AddColumn(FilterValidForecast, "LY_Year", each Date.Year([ForecastMonth]) - 1, Int64.Type),
				        "LY_Month", each Date.Month([ForecastMonth]), Int64.Type
				    ),
				
				    JoinLY = Table.NestedJoin(
				        AddLYKeys, {"Driver ID", "Version", "LY_Year", "LY_Month"},
				        ActualsLookup, {"Driver ID", "Version", "LY_Year", "LY_Month"},
				        "LYData", JoinKind.LeftOuter
				    ),
				    ExpandLY = Table.ExpandTableColumn(JoinLY, "LYData", {"LYValue"}, {"LY Same Month"}),
				
				    AddForecastYearMonth = Table.AddColumn(
				        Table.AddColumn(ExpandLY, "ForecastYear", each Date.Year([ForecastMonth]), Int64.Type),
				        "ForecastMonthNum", each Date.Month([ForecastMonth]), Int64.Type
				    ),
				
				    JoinHCForecast = Table.NestedJoin(
				        AddForecastYearMonth, {"ForecastYear", "ForecastMonthNum"},
				        HeadcountLookup, {"Year", "MonthNumber"},
				        "HCForecast", JoinKind.LeftOuter
				    ),
				    ExpandHCForecast = Table.ExpandTableColumn(JoinHCForecast, "HCForecast", {"Headcount"}, {"ForecastHeadcount"}),
				
				    JoinWCForecast = Table.NestedJoin(
				        ExpandHCForecast, {"ForecastYear", "ForecastMonthNum"},
				        WhiteCollarLookup, {"Year", "MonthNumber"},
				        "WCForecast", JoinKind.LeftOuter
				    ),
				    ExpandWCForecast = Table.ExpandTableColumn(JoinWCForecast, "WCForecast", {"WhiteCollarHC"}, {"ForecastWhiteCollarHC"}),
				
				    AddGrowthRate = Table.AddColumn(
				        ExpandWCForecast, "Growth Rate",
				        each Record.FieldOrDefault(GrowthRecord, [Driver Name] & "||" & [Substream Abbreviation], 0),
				        type number
				    ),
				
				    // ─────────────────────────────────────────────
				    // STEP H2: Forecast value - all methods
				    // ─────────────────────────────────────────────
				    AddForecastValue = Table.AddColumn(
				        AddGrowthRate, "Value",
				        each
				            let
				                sub = [Substream Abbreviation],
				                method = Record.FieldOrDefault(MethodRecord, sub, "growth"),
				                forecastYear = [ForecastYear],
				                forecastMonthNum = [ForecastMonthNum],
				                forecastDate = [ForecastMonth],
				                driverNameLower = Text.Lower([Driver Name]),
				                region = [Service Region],
				                version = [Version],
				                driverKey = Text.From([Driver ID]) & "||" & version,
				
				                // Growth method
				                growthValue =
				                    if [LY Same Month] = null then null
				                    else [LY Same Month] * (1 + [Growth Rate]),
				
				                // Headcount ratio method
				                hcValue =
				                    let
				                        driverYears = Record.FieldOrDefault(ActualRatiosNested, driverKey, null),
				                        yearKey = Number.ToText(forecastYear),
				                        actualMonthRatios = if driverYears = null then {} else Record.FieldOrDefault(driverYears, yearKey, {}),
				                        actualRatios = List.Transform(actualMonthRatios, each _[DriverHCRatio]),
				                        hc = [ForecastHeadcount],
				                        lastActualMonth = if List.Count(actualMonthRatios) = 0 then 0 else List.Max(List.Transform(actualMonthRatios, each _[MonthNumber])),
				                        priorForecastMonths = if forecastMonthNum <= lastActualMonth + 1 then {} else {(lastActualMonth + 1)..(forecastMonthNum - 1)},
				                        expandedRatios = List.Accumulate(
				                            priorForecastMonths, actualRatios,
				                            (state, m) => let avgSoFar = if List.Count(state) = 0 then 0 else List.Average(state) in state & {avgSoFar}
				                        ),
				                        finalAvg = if List.Count(expandedRatios) = 0 then null else List.Average(expandedRatios)
				                    in
				                        if finalAvg = null or hc = null then null else hc * finalAvg,
				
				                // Headcount avg method
				                hcAvgKey = Text.From([Driver ID]) & "||" & sub,
				                hcAvgValue =
				                    let
				                        ratio = Record.FieldOrDefault(HCAvgRatioDriverRecord, hcAvgKey, null),
				                        hc = [ForecastHeadcount],
				                        regionCount = Record.FieldOrDefault(RegionCountRecord, hcAvgKey, 1)
				                    in
				                        if ratio = null or hc = null or regionCount = 0 then null
				                        else (hc * ratio) / regionCount,
				
				                // TEM method
				                temValue =
				                    let
				                        wc = [ForecastWhiteCollarHC],
				                        temSubRatios = Record.FieldOrDefault(TEMRatioNested, sub, null),
				                        yearKey = Number.ToText(forecastYear),
				                        actualMonthRatios = if temSubRatios = null then {} else Record.FieldOrDefault(temSubRatios, yearKey, {}),
				                        filteredRatios = List.Select(actualMonthRatios, each _[MonthNumber] < forecastMonthNum),
				                        ratioValues = List.Transform(filteredRatios, each _[TEMRatio]),
				                        expandingAvg = if List.IsEmpty(ratioValues) then null else List.Average(ratioValues),
				                        forecastTotal = if expandingAvg = null or wc = null then null else wc * expandingAvg,
				                        totalAutoForecast = if TEMAutoRatio = null or forecastTotal = null then null
				                                            else forecastTotal * TEMAutoRatio,
				                        driverAutoSplit = Record.FieldOrDefault(TEMAutoSplitRecord, Text.From([Driver ID]), null),
				                        forecastAuto = if totalAutoForecast = null or driverAutoSplit = null then null
				                                       else totalAutoForecast * driverAutoSplit,
				                        versionValue =
				                            if version = "Total" then forecastTotal
				                            else if version = "Auto" then forecastAuto
				                            else if version = "Manual" then
				                                if forecastTotal = null or totalAutoForecast = null then null
				                                else forecastTotal - totalAutoForecast
				                            else null
				                    in
				                        versionValue,
				
				                // RS method - Resumes + Interviews with expanding avg ratios
				                rsValue =
				                    let
				                        regionLower = Text.Lower(region),
				
				                        // Get pre-computed ratio lists for this region
				                        resumeSalariedRatios = Record.FieldOrDefault(RSResumeSalariedRatiosByRegion, region, {}),
				                        resumeHourlyRatios = Record.FieldOrDefault(RSResumeHourlyRatiosByRegion, region, {}),
				                        interviewRatios = Record.FieldOrDefault(RSInterviewRatiosByRegion, region, {}),
				                        manualRates = Record.FieldOrDefault(RSManualRateByRegion, region, {}),
				
				                        // Get expanding averages up to forecast date
				                        avgResumeSalaried = GetExpandingAvg(resumeSalariedRatios, forecastDate),
				                        avgResumeHourly = GetExpandingAvg(resumeHourlyRatios, forecastDate),
				                        avgInterviewRatio = GetExpandingAvg(interviewRatios, forecastDate),
				                        avgManualRate = GetExpandingAvg(manualRates, forecastDate),
				
				                        // Get trigger values for forecast month
				                        activatedSalaried = GetTriggerValue("salaried + cse", region, forecastDate),
				                        activatedExecutive = GetTriggerValue("executive", region, forecastDate),
				                        activatedHourly = GetTriggerValue("hourly", region, forecastDate),
				
				                        // Forecast values
				                        // Resumes
				                        forecastResumeSalaried = (activatedSalaried + activatedExecutive) * avgResumeSalaried,
				                        forecastResumeHourly = activatedHourly * avgResumeHourly,
				
				                        // Interviews
				                        forecastInterviewAutoSalaried = activatedSalaried * (1 - avgManualRate) * avgInterviewRatio,
				                        forecastInterviewManualSalaried = activatedSalaried * avgManualRate * avgInterviewRatio,
				                        forecastInterviewManualExecutive = activatedExecutive * avgInterviewRatio,
				                        forecastInterviewManualHourly = activatedHourly * avgInterviewRatio,
				
				                        // Route to correct driver based on Driver Name
				                        result =
				    if Text.Contains(driverNameLower, "resumes") and Text.Contains(driverNameLower, "hourly") then
				        forecastResumeHourly
				    else if Text.Contains(driverNameLower, "resumes") and Text.Contains(driverNameLower, "salaried") then
				        forecastResumeSalaried
				    // Add this - Total = Hourly + Salaried
				    else if driverNameLower = "resumes received" then
				        forecastResumeHourly + forecastResumeSalaried
				    else if Text.Contains(driverNameLower, "interviews") and Text.Contains(driverNameLower, "salaried") and version = "Auto" then
				        forecastInterviewAutoSalaried
				    else if Text.Contains(driverNameLower, "interviews") and Text.Contains(driverNameLower, "salaried") and version = "Manual" then
				        forecastInterviewManualSalaried
				    else if Text.Contains(driverNameLower, "interviews") and Text.Contains(driverNameLower, "executive") then
				        forecastInterviewManualExecutive
				    else if Text.Contains(driverNameLower, "interviews") and Text.Contains(driverNameLower, "hourly") then
				        forecastInterviewManualHourly
				    else null
				                    in
				                        result
				            in
				                if method = "headcount_ratio" then hcValue
				                else if method = "headcount_avg" then hcAvgValue
				                else if method = "tem" then temValue
				                else if method = "rs" then rsValue
				                else growthValue,
				        type number
				    ),
				
				    DropHelpers = Table.RemoveColumns(
				        AddForecastValue,
				        {"LY_Year", "LY_Month", "ForecastYear", "ForecastMonthNum",
				         "ForecastHeadcount", "ForecastWhiteCollarHC", "Growth Rate"}
				    ),
				
				    RenameForecastDate = Table.RenameColumns(DropHelpers, {{"ForecastMonth", "Reporting Date"}}),
				    AddCrfcId = Table.AddColumn(RenameForecastDate, "crfc0_driverid", each null),
				    AddCrfcName = Table.AddColumn(AddCrfcId, "crfc0_name", each null),
				    ForecastEnriched = Table.AddColumn(AddCrfcName, "IsForecast", each true, type logical),
				
				    Combined = Table.Combine({ActualsEnriched, ForecastEnriched}),
				
				    AddYearMonth = Table.AddColumn(
				        Combined, "YearMonth",
				        each Date.ToText([Reporting Date], "yyyy-MM"),
				        type text
				    ),
				
				    AddLYYearForCapacity = Table.AddColumn(
				        AddYearMonth, "_LYYear",
				        each Date.Year([Reporting Date]) - 1,
				        Int64.Type
				    ),
				
				    JoinCapacity = Table.NestedJoin(
				        AddLYYearForCapacity, {"Substream Abbreviation", "Driver Name", "_LYYear"},
				        Capacity_Per_Substream_Year, {"Substream Abbreviation", "Driver Name", "Year"},
				        "CapData", JoinKind.LeftOuter
				    ),
				    ExpandCapacity = Table.ExpandTableColumn(
				        JoinCapacity, "CapData",
				        {"Manual per FTE Avg", "Manual per FTE Avg + Eff", "Manual per FTE LY Baseline"},
				        {"Manual per FTE Avg LY", "Manual per FTE Avg LY + Eff", "Manual per FTE LY Baseline"}
				    ),
				
				    DropHelper = Table.RemoveColumns(ExpandCapacity, {"_LYYear"}),
				
				    #"Changed Type" = Table.TransformColumnTypes(DropHelper, {{"Reporting Date", type date}})
				
				in
				    #"Changed Type"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

