	measure 'Adj. Variance + Eff Weighted' = ```
			
			VAR BaseVariance = [Weighted Variance + Eff]
			VAR OpenPositions = 
			    CALCULATE(
			        SUM('Manual Input (Scaling Model)'[OpenPositions])
			    )
			VAR RecruitmentNotStarted = 
			    CALCULATE(
			        SUM('Manual Input (Scaling Model)'[Recruitmentnotstarted])
			    )
			
			RETURN
			BaseVariance +
			    IF(
			        BaseVariance >= 0,
			        - OpenPositions,
			        + OpenPositions
			    )
