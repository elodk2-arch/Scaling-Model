	measure 'Activity Scaled FTE total' =
			
			VAR CurrentSubstream = MAX(Fact_Actuals[Substream Abbreviation])
			VAR VisibleDrivers = VALUES(Fact_Actuals[Driver Name])

			VAR DriverTable =
			    FILTER(
			        BaseProcessWeights,
			        BaseProcessWeights[SubStream] = CurrentSubstream
			            && CONTAINS(
			                VisibleDrivers,
			                Fact_Actuals[Driver Name],
			                BaseProcessWeights[Driver]
			            )
			    )
			
			VAR WeightedResult =
			    SUMX(
			        DriverTable,
			        VAR ThisDriver = BaseProcessWeights[Driver]
			        VAR DriverScaled =
			            AVERAGEX(
			                VALUES('DateTable'[YearMonth]),
			                CALCULATE(
			                    DIVIDE(
			                        [Total Driver new],
			                        AVERAGE('Fact_Actuals'[Manual per FTE Avg LY])
			                    ),
			                    Fact_Actuals[Driver Name] = ThisDriver
			                )
			            )
			        RETURN
			            DriverScaled * DIVIDE(BaseProcessWeights[Weight], 100)
			    )
			
			RETURN
			    WeightedResult
		lineageTag: 0c24a435-6ff0-4066-842e-883d081b793d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

