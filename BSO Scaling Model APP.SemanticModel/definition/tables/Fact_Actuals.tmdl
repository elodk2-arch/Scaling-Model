	measure 'Weighted Variance + Eff' = ```
			
			VAR Sub = MAX(Fact_Actuals[Substream Abbreviation])
			VAR Method = 
			    LOOKUPVALUE(
			        Stream_Forecast_Method[Forecast Method],
			        Stream_Forecast_Method[Substream Abbreviation], Sub
			    )
			
			VAR ActivityScaledEff =
			    SWITCH(
			        Method,
			        "headcount_ratio",  [Activity Scaled FTE total + Eff],
			        "headcount_avg",    [Activity Scaled FTE AVG + Eff],
			        "gl",               [Activity Scaled FTE GL + Eff],
			        "tem",              [Activity Scaled FTE + Eff] ,
			        "rs",               [RS Stream Activity Total +5 (Year)],
			        [Activity Scaled FTE + Eff Weighted]
			    )
			
			VAR GSOAdj = [Sum of GSO adjustment]
			
			VAR MappedFTE = 
			    CALCULATE(
			        SUM('FTE Data'[Mapped FTE]),
			        'FTE Data'[Active] = 1
			    )
			
			RETURN
			(GSOAdj + MappedFTE) - ActivityScaledEff
			```
