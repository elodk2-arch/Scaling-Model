	measure 'Growth Rate Dynamic' = ```
			
			VAR Sub = MAX(Fact_Actuals[Substream Abbreviation])
			VAR Cutoff = 
			    CALCULATE(
			        MAX(Fact_Actuals[Reporting Date]),
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Version] = "Total",
			        ALL(Fact_Actuals)
			    )
			VAR L12End = Cutoff
			VAR L12Start = EOMONTH(EDATE(Cutoff, -11), 0)
			VAR P12End = EOMONTH(EDATE(Cutoff, -12), 0)
			VAR P12Start = EOMONTH(EDATE(Cutoff, -23), 0)
			VAR Last12 = 
			    CALCULATE(
			        SUM(Fact_Actuals[Value]),
			        Fact_Actuals[Version] = "Total",
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Reporting Date] >= L12Start,
			        Fact_Actuals[Reporting Date] <= L12End
			    )
			VAR Prior12 = 
			    CALCULATE(
			        SUM(Fact_Actuals[Value]),
			        Fact_Actuals[Version] = "Total",
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Reporting Date] >= P12Start,
			        Fact_Actuals[Reporting Date] <= P12End
			    )
			RETURN
			    DIVIDE(Last12, Prior12) - 1
			```
		lineageTag: 91796583-1878-4d59-bcb9-8eef919c93dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LY FTE Avg (Growth Denominator)' =
			
			VAR CurrentDriver = SELECTEDVALUE ( 'Fact_Actuals'[Driver Name] )
			VAR CurrentSub = SELECTEDVALUE ( 'Fact_Actuals'[Substream Abbreviation] )
			VAR Cutoff =
			    CALCULATE (
			        MAX ( 'fact_Actuals'[Reporting Date] ),
			        'fact_Actuals'[Version] = "Total",
			        'fact_Actuals'[IsForecast] = FALSE(),
			        'fact_Actuals'[Value] <> 0,
			        'fact_Actuals'[Substream Abbreviation] = CurrentSub,
			        ALL ( 'fact_Actuals'[Reporting Date] )
			    )
			VAR P12End = EOMONTH ( Cutoff, -12 )
			VAR P12Start = EOMONTH ( Cutoff, -23 ) + 1
			VAR P12Sum =
			    CALCULATE (
			        SUM ( 'fact_Actuals'[Value] ),
			        'fact_Actuals'[Version] = "Total",
			        'fact_Actuals'[IsForecast] = FALSE(),
			        'fact_Actuals'[Driver Name] = CurrentDriver,
			        'fact_Actuals'[Substream Abbreviation] = CurrentSub,
			        'fact_Actuals'[Reporting Date] >= P12Start,
			        'fact_Actuals'[Reporting Date] <= P12End,
			        ALL ( 'fact_Actuals'[Reporting Date] )
			    )
			RETURN
			    DIVIDE ( P12Sum, 12 )
		lineageTag: 38ddf28d-6d59-4fb8-a5dc-266371b46308

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI Activity Scaled + Eff' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year], YEAR(TODAY()))
			
			VAR StreamTable = 
			    CALCULATETABLE(
			        VALUES('Sub_stream_combiner'[Substream abbreviation]),
			        ALLSELECTED('Sub_stream_combiner'[Substream abbreviation])
			    )
			VAR SelectedStreamCount = COUNTROWS(StreamTable)
			
			VAR HCStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "headcount_ratio"
			    )
			VAR HCAvgStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "headcount_avg"
			    )
			VAR GLStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "gl"
			    )
			VAR TEMStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "tem"
			    )
			VAR RSStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "rs"
			    )
			
			VAR IsHCStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, HCStreams)) = SelectedStreamCount
			
			VAR IsHCAvgStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, HCAvgStreams)) = SelectedStreamCount
			
			VAR IsGLStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, GLStreams)) = SelectedStreamCount
			
			VAR IsTEMStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, TEMStreams)) = SelectedStreamCount
			
			VAR IsRSStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, RSStreams)) = SelectedStreamCount
			
			RETURN
			CALCULATE(
			    SWITCH(
			        TRUE(),
			        IsHCStream,     [Activity Scaled FTE total + Eff],
			        IsHCAvgStream,  [Activity Scaled FTE AVG + Eff],
			        IsGLStream,     [Activity Scaled FTE GL + Eff],
			        IsTEMStream,    [Activity Scaled FTE + Eff Weighted],
			        IsRSStream,     [RS Stream Activity Total +5 (Year)],
			                        [Activity Scaled FTE + Eff Weighted]
			    ),
			    'DateTable'[Year] = SelectedYear
			)
			```
		lineageTag: 20550304-ca2b-458e-b205-5afc8302b9ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI Rolling Baseline' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year], YEAR(TODAY()))
			
			VAR LastActualMonth =
			    CALCULATE(
			        MAX('DateTable'[MonthNumber]),
			        Fact_Actuals[IsForecast] = FALSE(),
			        'DateTable'[Year] = SelectedYear
			    )
			
			VAR LastActualValue =
			    CALCULATE(
			        [Total Driver new],
			        Fact_Actuals[IsForecast] = FALSE(),
			        'DateTable'[Year] = SelectedYear,
			        'DateTable'[MonthNumber] = LastActualMonth
			    )
			
			VAR GrowthRate =
			    CALCULATE(
			        AVERAGE(Fact_Actuals[Growth Rate]),
			        Fact_Actuals[IsForecast] = FALSE(),
			        'DateTable'[Year] = SelectedYear,
			        'DateTable'[MonthNumber] = LastActualMonth
			    )
			
			VAR StreamTable = 
			    CALCULATETABLE(
			        VALUES('Sub_stream_combiner'[Substream abbreviation]),
			        ALLSELECTED('Sub_stream_combiner'[Substream abbreviation])
			    )
			VAR SelectedStreamCount = COUNTROWS(StreamTable)
			
			VAR HCStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "headcount_ratio"
			    )
			VAR HCAvgStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "headcount_avg"
			    )
			VAR GLStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "gl"
			    )
			VAR TEMStreams = 
			    CALCULATETABLE(
			        VALUES('Stream_Forecast_Method'[Substream Abbreviation]),
			        'Stream_Forecast_Method'[Forecast Method] = "tem"
			    )
			
			VAR IsHCStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, HCStreams)) = SelectedStreamCount
			VAR IsHCAvgStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, HCAvgStreams)) = SelectedStreamCount
			VAR IsGLStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, GLStreams)) = SelectedStreamCount
			VAR IsTEMStream = 
			    SelectedStreamCount > 0
			    && COUNTROWS(INTERSECT(StreamTable, TEMStreams)) = SelectedStreamCount
			
			RETURN
			CALCULATE(
			    SWITCH(
			        TRUE(),
			        // HC ratio — show avg ratio used
			        IsHCStream,
			            DIVIDE(
			                [Total Driver new],
			                SELECTEDVALUE(Fact_Headcount[Headcount], BLANK())
			            ),
			        // HC Avg — show LY Total / LY Dec HC / 12
			        IsHCAvgStream,
			            CALCULATE(
			                DIVIDE([Total Driver new], MAX(Fact_Headcount[Headcount])),
			                'DateTable'[Year] = SelectedYear - 1,
			                'DateTable'[MonthNumber] = 12,
			                ALL('DateTable')
			            ),
			        // GL — show LY Driver / (LY FTE × (1 + Vacancy))
			        IsGLStream,
			            CALCULATE(
			                DIVIDE(
			                    [Total Driver new],
			                    [Active FTE Avg] * 1.087
			                ),
			                'DateTable'[Year] = SelectedYear - 1,
			                ALL('DateTable')
			            ),
			        // TEM — show last actual White Collar HC ratio
			        IsTEMStream,
			            DIVIDE(LastActualValue, 
			                CALCULATE(
			                    MAX(Headcount_White_Collar_Mock[WhiteCollarHC]),
			                    Headcount_White_Collar_Mock[Year] = SelectedYear,
			                    Headcount_White_Collar_Mock[MonthNumber] = LastActualMonth
			                )
			            ),
			        // Growth — show last actual value × (1 + growth rate)
			        LastActualValue * (1 + GrowthRate)
			    ),
			    'DateTable'[Year] = SelectedYear
			)
			```
		lineageTag: 6542a761-70be-4894-955d-2311cb99abc5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Output Growth (%) new' = ```
			
			VAR Cutoff = 
			    CALCULATE(
			        MAX(Fact_Actuals[Reporting Date]),
			        Fact_Actuals[IsForecast] = FALSE()
			    )
			
			VAR L12Start = EOMONTH(EDATE(Cutoff, -11), 0)
			VAR P12End   = EOMONTH(EDATE(Cutoff, -12), 0)
			VAR P12Start = EOMONTH(EDATE(Cutoff, -23), 0)
			
			VAR Last12 = 
			    CALCULATE(
			        [Total Driver new],
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Reporting Date] >= L12Start,
			        Fact_Actuals[Reporting Date] <= Cutoff
			    )
			
			VAR Prev12 = 
			    CALCULATE(
			        [Total Driver new],
			        Fact_Actuals[IsForecast] = FALSE(),
			        Fact_Actuals[Reporting Date] >= P12Start,
			        Fact_Actuals[Reporting Date] <= P12End
			    )
			
			RETURN
			IF(
			    Prev12 = 0 || ISBLANK(Prev12),
			    BLANK(),
			    (Last12 / Prev12 - 1) * 100
			)
			```
