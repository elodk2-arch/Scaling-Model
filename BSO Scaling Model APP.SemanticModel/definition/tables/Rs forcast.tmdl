			            'Driver Map'[Version] = "Manual",
			            
			            -- Keep the active date table relationship active for actuals context
			            KEEPFILTERS(DateTable) 
			        )
			
			    VAR _Bmanual =
			        CALCULATE(
			            SUM('Driver Data'[Value]),
			            REMOVEFILTERS('Driver Map'),
			            'Driver Map'[Driver Name] = "Activated Recruitments - Hourly",
			            'Driver Map'[Version] = "Trigger",
			            
			            -- FIXED: Added virtual mapping to bridge the non-active reporting date relationship
			            REMOVEFILTERS(DateTable),
			            TREATAS(
			                { _CurrentYearMonth },
			                'Driver Data'[Reporting Date]
			            )
			        )
			
			    VAR _PrevInterviewRatio =
			        CALCULATE(
			            [Interviews Scheduled (Salaried + CSE) / Activated recruitments (Salaried + CSE )],
			            REMOVEFILTERS(DateTable), -- FIXED: Added date clear for background lookups
			            DateTable[YearMonth] = _PrevYearMonth
