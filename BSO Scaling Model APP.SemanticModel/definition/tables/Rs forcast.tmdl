	measure 'RS Activity scaled Selector (month)' = ```
			
			
			VAR ResumeValue =
			    [Activity scaled Resume Recived (Month)]
			
			VAR InterviewValue =
			    [Activity scaled interviews schedualed (Month)]
			
			VAR DriverCount =
			    COUNTROWS(VALUES('Driver Map'[Driver Name]))    
			
			VAR AllInterview =
			    COUNTROWS(
			        FILTER(VALUES('Driver Map'[Driver Name]),
			            CONTAINSSTRING('Driver Map'[Driver Name], "Interview"))
			    ) = DriverCount
			
			VAR AllResume =
			    COUNTROWS(
			        FILTER(VALUES('Driver Map'[Driver Name]),
			            CONTAINSSTRING('Driver Map'[Driver Name], "Resume"))
			    ) = DriverCount
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    AllResume,
			        ResumeValue,
			
			    AllInterview,
			        InterviewValue,
			
			    -- Mix of both or no filter
			    (ResumeValue + InterviewValue) / 2
			)
			```
