	measure 'RS Total (Automated) Selector' = ```
			
			
			VAR ResumeValue =
			    [Resumes Received (Salaried + CSE) (Actual vs Forecast)]
			
			VAR InterviewValue =
			    [Interviews Scheduled (automation, Salaried + CSE) (Actual vs Forecast)]
			
			VAR DriverCount =
			    COUNTROWS(VALUES('Driver Map'[Driver Name]))    
			
			VAR AllInterview =
			    COUNTROWS(
			        FILTER(VALUES('Driver Map'[Driver Name]),
			            CONTAINSSTRING('Driver Map'[Driver Name], "Interview"))
			    ) = DriverCount
			
			VAR AllResume =
			    COUNTROWS(
			        FILTER(VALUES('Driver Map'[Driver Name]),
			            CONTAINSSTRING('Driver Map'[Driver Name], "Resumes"))
			    ) = DriverCount
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    AllResume,
			        ResumeValue,
			
			    AllInterview,
			        InterviewValue,
			
			    -- Mix of both or no filter
			    (ResumeValue + InterviewValue) / 2
			)
			```
		lineageTag: 6764750b-3da9-4ba9-88a3-0b23b239233b

	measure 'Interviews Scheduled (automation, Salaried + CSE) (Actual vs Forecast)' = ```
			
			SUMX(
			    VALUES(DateTable[YearMonth]),
			    
			    VAR _CurrentYearMonth = DateTable[YearMonth]
			    VAR _CurrentYear = LEFT(_CurrentYearMonth, 4)
			    VAR _CurrentMonth = RIGHT(_CurrentYearMonth, 2)
			
			    VAR _PrevYearMonth =
			        IF(
			            _CurrentMonth = "01",
			            (_CurrentYear - 1) & "-12",
			            _CurrentYear & "-" & FORMAT(VALUE(_CurrentMonth) - 1, "00")
			        )
			
			    VAR _Actuals = [Auto Interviews Scheduled]
			
			    VAR _Bmanual =
			        CALCULATE(
			            SUM('Driver Data'[Value]), -- 1. Pulling from Driver Data
			            REMOVEFILTERS('Driver Map'),
			            'Driver Map'[Driver Name] = "Activated Recruitments - Salaried + CSE",
			            'Driver Map'[Version] = "Trigger",
			            
			            -- 2. Direct virtual mapping to bridge the non-active relationship
			            REMOVEFILTERS(DateTable),
			            TREATAS(
			                { _CurrentYearMonth },
			                'Driver Data'[Reporting Date]
			            )
			        )
			
			    VAR _PrevManualRate =
			        CALCULATE(
			            [Interviews manual rate (actual only)],
			            REMOVEFILTERS(DateTable), -- 3. Clear context to look at m-1
			            DateTable[YearMonth] = _PrevYearMonth
			        )
			
			    VAR _PrevInterviewRatio =
			        CALCULATE(
			            [Interviews Scheduled (Salaried + CSE) / Activated recruitments (Salaried + CSE )],
			            REMOVEFILTERS(DateTable), -- 4. Clear context to look at m-1
			            DateTable[YearMonth] = _PrevYearMonth
			        )
			
			    VAR _FallbackManualRate =
			        CALCULATE(
			            [Interviews manual rate (actual only)],
			            REMOVEFILTERS(DateTable), -- 5. Clear context to look at Jan
			            DateTable[YearMonth] = _CurrentYear & "-01"
			        )
			
			    VAR _FallbackInterviewRatio =
			        CALCULATE(
			            [Interviews Scheduled (Salaried + CSE) / Activated recruitments (Salaried + CSE )],
			            REMOVEFILTERS(DateTable), -- 6. Clear context to look at Jan
			            DateTable[YearMonth] = _CurrentYear & "-01"
			        )
			
			    VAR _FinalManualRate =
			        IF(_PrevManualRate = 0 || ISBLANK(_PrevManualRate), _FallbackManualRate, _PrevManualRate)
			
			    VAR _FinalInterviewRatio =
			        IF(_PrevInterviewRatio = 0 || ISBLANK(_PrevInterviewRatio), _FallbackInterviewRatio, _PrevInterviewRatio)
			
			    VAR _Forecast =
			        _Bmanual * (1 - _FinalManualRate) * _FinalInterviewRatio
			
			    RETURN
			        IF(ISBLANK(_Actuals) || _Actuals = 0, _Forecast, _Actuals)
			)
			```
