	measure 'Interviews Scheduled (manual, Executive)(Actual vs Forecast)' = ```
			
			SUMX(
			    VALUES(DateTable[YearMonth]), -- Added iteration loop for total rows and charts
			    
			    VAR _CurrentYearMonth = DateTable[YearMonth]
			    VAR _CurrentYear = LEFT(_CurrentYearMonth, 4)
			    VAR _CurrentMonth = RIGHT(_CurrentYearMonth, 2)
			
			    VAR _PrevYearMonth = 
			        IF(
			            _CurrentMonth = "01",
			            (_CurrentYear - 1) & "-12",
			            _CurrentYear & "-" & FORMAT(VALUE(_CurrentMonth) - 1, "00")
			        )
			
			    -- Actual data (uses current context of the loop)
			    VAR _Actuals = 
			        CALCULATE(
			            SUM('Fact_Actuals'[Value]),
			            ALL('Driver Map'),
			            'Driver Map'[Driver Name] = "Interviews Scheduled - Executive",
			            'Driver Map'[Version] = "Manual"
			        )
			
			    -- Bmanual for current month (Executive)
			    VAR _Bmanual = 
			        CALCULATE(
			            SUM('Driver Data'[Value]), -- Fixed to point to Driver Data
			            REMOVEFILTERS('Driver Map'),
			            'Driver Map'[Driver Name] = "Activated Recruitments - Executive",
			            'Driver Map'[Version] = "Trigger",
			            
			            -- Direct virtual mapping to bridge the non-active relationship
			            REMOVEFILTERS(DateTable),
			            TREATAS(
			                { _CurrentYearMonth },
			                'Driver Data'[Reporting Date]
			            )
			        )
			
			    -- Interview ratio from previous month
			    VAR _PrevInterviewRatio =
			        CALCULATE(
			            [Interviews Scheduled (Salaried + CSE) / Activated recruitments (Salaried + CSE )],
			            REMOVEFILTERS(DateTable), -- Fixed filter block
			            DateTable[YearMonth] = _PrevYearMonth
			        )
			
			    -- Fallback to January
			    VAR _FallbackInterviewRatio =
			        CALCULATE(
			            [Interviews Scheduled (Salaried + CSE) / Activated recruitments (Salaried + CSE )],
			            REMOVEFILTERS(DateTable), -- Fixed filter block
			            DateTable[YearMonth] = _CurrentYear & "-01"
			        )
			
			    VAR _FinalInterviewRatio = 
			        IF(_PrevInterviewRatio = 0 || ISBLANK(_PrevInterviewRatio), _FallbackInterviewRatio, _PrevInterviewRatio)
			
			    VAR _Forecast = _Bmanual * _FinalInterviewRatio
			
			    RETURN
			        IF(ISBLANK(_Actuals) || _Actuals = 0, _Forecast, _Actuals)
			)
			```
		lineageTag: 405139a6-c4de-4f29-a361-bdc6d9828c2a

