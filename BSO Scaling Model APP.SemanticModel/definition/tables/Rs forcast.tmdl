	measure 'FTE Yearly Average (Adjusted)' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year], YEAR(TODAY()))
			VAR MonthlyFTEs =
			    ADDCOLUMNS(
			        VALUES('DateTable'[MonthNumber]), 
			        "@FTE", [Active FTE new]
			    )
			RETURN
			CALCULATE(
			    AVERAGEX(MonthlyFTEs, [@FTE]),
			    YEAR('DateTable'[Date]) = SelectedYear
			)
			
