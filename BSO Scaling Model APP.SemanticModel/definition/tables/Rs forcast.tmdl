	lineageTag: c69b8dad-76dc-4a7a-9870-e9109f2b4c61

	measure 'RS Total Selector' = ```
			
			
			VAR ResumeValue =
			    [Resumes received (total) (Actual vs forecast)]
			
			VAR InterviewValue =
			    [Total Interviews All (Actual vs Forecast)]
			
			VAR DriverCount =
			    COUNTROWS(VALUES('Driver Map'[Driver Name]))    
			
			    
			VAR AllInterview =
			    COUNTROWS(
			        FILTER(VALUES('Driver Map'[Driver Name]),
			            CONTAINSSTRING('Driver Map'[Driver Name], "Interview"))
			    ) = DriverCount
			
			    VAR AllResume =
			    COUNTROWS(
			        FILTER(VALUES('Driver Map'[Driver Name]),
			            CONTAINSSTRING('Driver Map'[Driver Name], "Resumes"))
			    ) = DriverCount
			
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    -- All selected drivers are Resume
			    AllResume,
			        ResumeValue,
			
			    -- All selected drivers are Interview
			    AllInterview,
			        InterviewValue,
			
			    -- Mix of both or no filter
			    ResumeValue * 0.53 + InterviewValue * 0.47
			)
			```
		lineageTag: 3c25e3cf-61fc-468c-9e29-a2865bec435a

	measure 'Resumes received (total) (Actual vs forecast)' =
			
			
			[Resumes Received (Salaried + CSE) (Actual vs Forecast)] + [Resumes Received (Hourly) (Actual vs Forecast)]
		lineageTag: 28badcdd-70de-4cda-a072-2f6e15d893b4

	measure 'Resumes Received (Salaried + CSE) (Actual vs Forecast)' = ```
			
			SUMX(
			    VALUES(DateTable[YearMonth]), -- 1. Loop through ALL calendar months
			    
			    VAR _CurrentYearMonth = DateTable[YearMonth]
			    VAR _CurrentYear = LEFT(_CurrentYearMonth, 4)
			    VAR _CurrentMonth = RIGHT(_CurrentYearMonth, 2)
			
			    // m-1
			    VAR _PrevYearMonth1 =
			        IF(
			            _CurrentMonth = "01",
			            (_CurrentYear - 1) & "-12",
			            _CurrentYear & "-" & FORMAT(VALUE(_CurrentMonth) - 1, "00")
			        )
			
			    // m-2
			    VAR _PrevYear1 = LEFT(_PrevYearMonth1, 4)
			    VAR _PrevMonth1 = RIGHT(_PrevYearMonth1, 2)
			
			    VAR _PrevYearMonth2 =
			        IF(
			            _PrevMonth1 = "01",
			            (_PrevYear1 - 1) & "-12",
			            _PrevYear1 & "-" & FORMAT(VALUE(_PrevMonth1) - 1, "00")
			        )
			
			    VAR _Actuals = [Actual Resumes Recived (Salaried + CSE + Executive)]  
			
			    VAR _Bmanual =
			        CALCULATE(
			            SUM('Driver Data'[Value]), -- 2. Pulling from Driver Data
			            REMOVEFILTERS('Driver Map'), 
			            'Driver Map'[Driver Name] = "Activated Recruitments - Salaried + CSE",
			            'Driver Map'[Version] = "Trigger",
			            
			            -- 3. Virtual relation to overcome the role-playing reporting date
			            REMOVEFILTERS(DateTable),
			            TREATAS(
			                { _CurrentYearMonth },
			                'Driver Data'[Reporting Date]
			            )
			        )
			
			    // Ratio for m-1
			    VAR _ResumeRatio_M1 =
			        CALCULATE(
			            [Resumes received (Salaried + CSE + Executive) / Activated Recruitments (Salaried + CSE + Executive)],
			            REMOVEFILTERS(DateTable), -- 4. Clean date tables for lookups
			            DateTable[YearMonth] = _PrevYearMonth1
			        )
			
			    // Ratio for m-2
			    VAR _ResumeRatio_M2 =
			        CALCULATE(
			            [Resumes received (Salaried + CSE + Executive) / Activated Recruitments (Salaried + CSE + Executive)],
			            REMOVEFILTERS(DateTable),
			            DateTable[YearMonth] = _PrevYearMonth2
			        )
			
			    // Fallback to January if both are 0
			    VAR _FallbackResumeRatio =
			        CALCULATE(
			            [Resumes received (Salaried + CSE + Executive) / Activated Recruitments (Salaried + CSE + Executive)],
			            REMOVEFILTERS(DateTable),
			            DateTable[YearMonth] = _CurrentYear & "-01"
			        )
			
			    // Average of the two months
			    VAR _AvgResumeRatio =
			        VAR _R1 = IF(_ResumeRatio_M1 = 0, BLANK(), _ResumeRatio_M1)
			        VAR _R2 = IF(_ResumeRatio_M2 = 0, BLANK(), _ResumeRatio_M2)
			        RETURN
			            IF(
			                _R1 = BLANK() && _R2 = BLANK(),
			                _FallbackResumeRatio,
			                DIVIDE(_R1 + _R2, IF(_R1 <> BLANK() && _R2 <> BLANK(), 2, 1))
			            )
			
			    VAR _Forecast =
			        _Bmanual * _AvgResumeRatio
			
			    RETURN
			        IF(ISBLANK(_Actuals) || _Actuals = 0, _Forecast, _Actuals)
			)
			```
		lineageTag: 041cc7f9-225c-4cfe-8031-93fe058886de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

