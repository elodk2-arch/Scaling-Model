	measure 'Resumes Received (Hourly) (Actual vs Forecast)' = ```
			
			SUMX(
			    VALUES(DateTable[YearMonth]), -- SWAPPED: Now loops through ALL months in your calendar
			    
			    VAR _CurrentYearMonth = DateTable[YearMonth] -- SWAPPED: Evaluates current calendar month
			    VAR _CurrentYear = LEFT(_CurrentYearMonth, 4)
			    VAR _CurrentMonth = RIGHT(_CurrentYearMonth, 2)
			
			    // m-1
			    VAR _PrevYearMonth1 =
			        IF(
			            _CurrentMonth = "01",
			            (_CurrentYear - 1) & "-12",
			            _CurrentYear & "-" & FORMAT(VALUE(_CurrentMonth) - 1, "00")
			        )
			
			    // m-2
			    VAR _PrevYear1 = LEFT(_PrevYearMonth1, 4)
			    VAR _PrevMonth1 = RIGHT(_PrevYearMonth1, 2)
			
			    VAR _PrevYearMonth2 =
			        IF(
			            _PrevMonth1 = "01",
			            (_PrevYear1 - 1) & "-12",
			            _PrevYear1 & "-" & FORMAT(VALUE(_PrevMonth1) - 1, "00")
			        )
			
			    VAR _Actuals = [Actual Resumes Recived (Hourly)]  
			
			VAR _Bmanual =
			        CALCULATE(
			            SUM('Driver Data'[Value]), 
			            REMOVEFILTERS('Driver Map'), 
			            'Driver Map'[Driver Name] = "Activated Recruitments - Hourly",
			            'Driver Map'[Version] = "Trigger",
			            
			            -- VIRTUALLY PASS THE DATE FILTER WITHOUT A RELATIONSHIP:
			            REMOVEFILTERS(DateTable), -- Clears the native active relationship filter
			            TREATAS(
			                { _CurrentYearMonth }, -- The single YearMonth string from the current SUMX row
			                'Driver Data'[Reporting Date] -- Injects it directly into your driver data column
			            )
			        )
			
			    // Ratio for m-1
			    VAR _ResumeRatio_M1 =
			        CALCULATE(
			            [Resumes received (Hourly) / Activated Recruitments (Hourly)],
			            REMOVEFILTERS(DateTable), -- Clear date filters to look backward
			            DateTable[YearMonth] = _PrevYearMonth1
			        )
			
			    // Ratio for m-2
			    VAR _ResumeRatio_M2 =
			        CALCULATE(
			            [Resumes received (Hourly) / Activated Recruitments (Hourly)],
			            REMOVEFILTERS(DateTable), -- Clear date filters to look backward
			            DateTable[YearMonth] = _PrevYearMonth2
			        )
			
			    // Fallback to January if both are 0
			    VAR _FallbackResumeRatio =
			        CALCULATE(
			            [Resumes received (Hourly) / Activated Recruitments (Hourly)],
			            REMOVEFILTERS(DateTable), -- Clear date filters for the fallback
			            DateTable[YearMonth] = _CurrentYear & "-01"
			        )
			
			    // Average of the two months
			    VAR _AvgResumeRatio =
			        VAR _R1 = IF(_ResumeRatio_M1 = 0, BLANK(), _ResumeRatio_M1)
			        VAR _R2 = IF(_ResumeRatio_M2 = 0, BLANK(), _ResumeRatio_M2)
			        RETURN
			            IF(
			                _R1 = BLANK() && _R2 = BLANK(),
			                _FallbackResumeRatio,
			                DIVIDE(_R1 + _R2, IF(_R1 <> BLANK() && _R2 <> BLANK(), 2, 1))
			            )
			
			    VAR _Forecast =
			        _Bmanual * _AvgResumeRatio
			
			RETURN
			        IF(_Actuals > 0, _Actuals, _Forecast)
			)
			```
		lineageTag: 262f23c5-8c44-4d1b-9739-3469d0ae1aba

