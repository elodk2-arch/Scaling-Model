	measure 'SDA Volume Change %' =
			
			DIVIDE(
			    [SDA CY Volume] - [SDA LY Volume],
			    [SDA LY Volume]
			) * 100
		lineageTag: 040bc41c-9957-4742-97a6-811bf86081ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SDA FTE Change %' =
			
			DIVIDE(
			    [SDA CY FTE] - [SDA LY FTE],
			    [SDA LY FTE]
			) * 100
		lineageTag: 02ff3f23-173d-4802-bca9-7e7bf4931ae9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SDA Analysis Category' =
			
			VAR VolChange = [SDA Volume Change %]
			VAR FTEChange = [SDA FTE Change %]
			RETURN
			SWITCH(
			    TRUE(),
			    // Volume up, FTE down = best case
			    VolChange > 0 && FTEChange <= 0,
			        "✅ Productivity gain — more output with fewer resources",
			
			    // Volume up, FTE up but volume growing faster = good
			    VolChange > 0 && FTEChange > 0 && VolChange > FTEChange,
			        "✅ Scaling efficiently — volume growing faster than headcount",
			
			    // Volume up, FTE up at same or faster rate = neutral/concern
			    VolChange > 0 && FTEChange > 0 && VolChange <= FTEChange,
			        "⚠️ Volume growth not keeping pace with headcount increase",
			
			    // Volume down, FTE down faster = right-sizing well
			    VolChange < 0 && FTEChange < 0 && ABS(FTEChange) > ABS(VolChange),
			        "✅ Right-sizing — headcount reduced faster than volume decline",
			
			    // Volume down, FTE down slower = concern
			    VolChange < 0 && FTEChange < 0 && ABS(FTEChange) < ABS(VolChange),
			        "⚠️ Volume declining faster than headcount adjustment",
			
			    // Volume down, FTE up = worst case
			    VolChange < 0 && FTEChange > 0,
			        "🔴 Capacity under pressure — volume declining while headcount grows",
			
			    // Volume flat, FTE down = good
			    VolChange = 0 && FTEChange < 0,
			        "✅ Same output with fewer resources",
			
			    "➡️ Stable — no significant change in volume or headcount"
			)
		lineageTag: 631287ee-0b14-450b-a407-a3d5e9cb60d6

	measure 'SDA Insight' =
			
			VAR VolChange = [SDA Volume Change %]
			VAR FTEChange = [SDA FTE Change %]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(VolChange) || ISBLANK(FTEChange),
			        "Awaiting comparable volume and FTE data",
			    VolChange > 0 && FTEChange <= 0,
			        "More output with fewer or equal resources",
			    VolChange > 0 && FTEChange > 0 && VolChange > FTEChange,
			        "Output is growing faster than resources",
			    VolChange < 0 && FTEChange < 0 && ABS(FTEChange) > ABS(VolChange),
			        "Resources are reducing faster than output",
			    VolChange < 0 && FTEChange > 0,
			        "Capacity is rising while output is falling",
			    "Resource movement needs investigation"
			)
		lineageTag: 0e8b8f1c-0ec4-4f59-9c2e-13f55734062a

