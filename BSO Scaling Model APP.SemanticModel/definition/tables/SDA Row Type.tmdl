table 'SDA Row Type'
	lineageTag: 8491e856-4631-4358-a9d9-778932964a38

	measure 'SDA Table Value' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year], YEAR(TODAY()))
			VAR RowType = SELECTEDVALUE('SDA Row Type'[RowType])
			VAR LYYear = SelectedYear - 1
			
			VAR CYVolume = 
			    CALCULATE(
			        [SDA Driver Switch],
			        'DateTable'[Year] = SelectedYear,
			        ALL('DateTable')
			    )
			VAR LYVolume = 
			    CALCULATE(
			        [SDA Driver Switch],
			        'DateTable'[Year] = LYYear,
			        ALL('DateTable')
			    )
			VAR CYFTE = 
			    CALCULATE(
			        [SDA FTE Switch Weighted],
			        'DateTable'[Year] = SelectedYear,
			        ALL('DateTable')
			    )
			VAR LYFTE = 
			    CALCULATE(
			        [SDA FTE Switch Weighted],
			        'DateTable'[Year] = LYYear,
			        ALL('DateTable')
			    )
			
			RETURN
			SWITCH(
			    RowType,
			    "Volume", 
			        SWITCH(
			            SELECTEDVALUE('DateTable'[Year]),
			            SelectedYear, CYVolume,
			            LYYear, LYVolume
			        ),
			    "FTE",
			        SWITCH(
			            SELECTEDVALUE('DateTable'[Year]),
			            SelectedYear, CYFTE,
			            LYYear, LYFTE
			        )
			)
			```
		lineageTag: b965f868-3b0d-463e-903b-8c7eda936d6a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SDA Change %' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year], YEAR(TODAY()))
			VAR RowType = SELECTEDVALUE('SDA Row Type'[RowType])
			VAR LYYear = SelectedYear - 1
			
			VAR CYValue = 
			    CALCULATE(
			        IF(RowType = "Volume", [SDA Driver Switch], [SDA FTE Switch Weighted]),
			        'DateTable'[Year] = SelectedYear,
			        ALL('DateTable')
			    )
			VAR LYValue = 
			    CALCULATE(
			        IF(RowType = "Volume", [SDA Driver Switch], [SDA FTE Switch Weighted]),
			        'DateTable'[Year] = LYYear,
			        ALL('DateTable')
			    )
			
			RETURN
			DIVIDE(CYValue - LYValue, LYValue) * 100
			```
		lineageTag: 1914c5ab-46e6-496b-a20a-6c119489225e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

