table Headcount_Mock
	lineageTag: eaf7031b-5d2f-426d-aee7-ae32e7c6224b

	measure 'Total Headcount Selected Year' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year])
			RETURN
			CALCULATE(
			    MAX('Headcount_Mock'[Total Headcount]),
			    'Headcount_Mock'[Year] = SelectedYear,
			    'Headcount_Mock'[MonthNumber] = 12
			)
			
			```
		formatString: 0
		lineageTag: 75648525-ea57-491f-a5df-82bade07cf7d

	measure 'Headcount Forecast Dynamic' = ```
			
			VAR CurrentYear =
			    MAX('DateTable'[Year])
			
			VAR CurrentMonth =
			    MAX('DateTable'[MonthNumber])
			
			VAR ActualValue =
			    CALCULATE(
			        MAX(Headcount_Mock[Total Headcount]),
			        Headcount_Mock[Year] = CurrentYear,
			        Headcount_Mock[MonthNumber] = CurrentMonth
			    )
			
			VAR LastActualMonth =
			    CALCULATE(
			        MAX(Headcount_Mock[MonthNumber]),
			        FILTER(
			            ALL(Headcount_Mock),
			            Headcount_Mock[Year] = CurrentYear &&
			            Headcount_Mock[MonthNumber] < 12 &&
			            NOT ISBLANK(Headcount_Mock[Total Headcount])
			        )
			    )
			
			VAR LastActualValue =
			    CALCULATE(
			        MAX(Headcount_Mock[Total Headcount]),
			        Headcount_Mock[Year] = CurrentYear,
			        Headcount_Mock[MonthNumber] = LastActualMonth
			    )
			
			VAR DecemberTarget =
			    CALCULATE(
			        MAX(Headcount_Mock[Total Headcount]),
			        Headcount_Mock[Year] = CurrentYear,
			        Headcount_Mock[MonthNumber] = 12
			    )
			
			VAR RemainingMonths =
			    12 - LastActualMonth
			
			VAR MonthlyIncrease =
			    DIVIDE(
			        DecemberTarget - LastActualValue,
			        RemainingMonths
			    )
			
			VAR ForecastValue =
			    LastActualValue +
			    (CurrentMonth - LastActualMonth) * MonthlyIncrease
			
			RETURN
			IF(
			    NOT ISBLANK(ActualValue) && CurrentMonth <= LastActualMonth,
			    ActualValue,
			    IF(
			        CurrentMonth > LastActualMonth,
			        ForecastValue
			    )
			)
			
			```
		lineageTag: 7499663e-93c3-48ba-9f69-cbf91325520a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test Month' = ```
			MAX('DateTable'[MonthNumber])
			
			```
