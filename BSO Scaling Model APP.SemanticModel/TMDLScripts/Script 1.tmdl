					    FILTER(
					        'Headcount_Mock',
					        'Headcount_Mock'[Year] = SELECTEDVALUE('DateTable'[Year])
					        && 'Headcount_Mock'[MonthNumber] = SELECTEDVALUE('DateTable'[MonthNumber])
