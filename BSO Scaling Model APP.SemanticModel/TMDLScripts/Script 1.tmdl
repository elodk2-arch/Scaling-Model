			measure 'Driver per Headcount (2025)' = ```
					
					VAR CurrentYear =
					    SELECTEDVALUE('DateTable'[Year])
					VAR CurrentMonth =
					    SELECTEDVALUE('DateTable'[MonthNumber])
					
					// Get current month's headcount from existing measure
					VAR Headcount_2025 =
					    [Headcount 2025 (Hardcoded)]
					
					// Get driver actual for current month/year
					VAR DriverActual =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        FILTER(
					            'Driver Data',
					            YEAR('Driver Data'[Reporting Date]) = CurrentYear &&
					            MONTH('Driver Data'[Reporting Date]) = CurrentMonth
					        )
					    )
					
					RETURN
					IF(
					    CurrentYear = 2025,
					    DIVIDE(DriverActual, Headcount_2025),
					    BLANK()
					)
					
					```
				lineageTag: bf85b185-a5fb-47d6-a150-a564b7808b6a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Driver Total Forecast (Working for headcount?)' = ```
					
					VAR ForecastYear = 2025
					
					RETURN
					SUMX(
					    VALUES('DateTable'[MonthNumber]),
					    VAR CurrentMonth = 'DateTable'[MonthNumber]
					
					    -- 1. Current headcount (all months/regions respected)
					    VAR CurrentMonthHeadcount =
					        CALCULATE(
					            [Headcount 2025 (Hardcoded)],
					            'DateTable'[Year] = ForecastYear
					        )
					
					    -- 2. Actual driver for current month
					    VAR DriverActual =
					        CALCULATE(
					            SUM('Driver Data'[Value]),
					            'DateTable'[Year] = ForecastYear,
					            'DateTable'[MonthNumber] = CurrentMonth,
					            'Driver Map'[Version] = "Total"
					        )
					
					    -- 3. Average driver per headcount from previous months
					    VAR AvgDriverPerHeadcount =
					        CALCULATE(
					            AVERAGEX(
					                FILTER(
					                    ALL('DateTable'),
					                    'DateTable'[Year] = ForecastYear
					                        && 'DateTable'[MonthNumber] < CurrentMonth
					                        && NOT ISBLANK([Driver per Headcount (2025)])
					                ),
					                [Driver per Headcount (2025)]
					            )
					        )
					
					    -- 4. Forecast if no actual exists
					    VAR DriverForecast = CurrentMonthHeadcount * AvgDriverPerHeadcount
					
					    RETURN
					        IF(
					            NOT ISBLANK(DriverActual),
					            DriverActual,
					            DriverForecast
					        )
					)
					
					```
				lineageTag: be9cdab2-0dc6-48c0-845d-a50da6d498e0

