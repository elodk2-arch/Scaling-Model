					[Forecast or Actuals dynamic total]
					
					VAR HeadcountActual =
					    [Headcount per Month]
					
					RETURN
					IF(
					    NOT ISBLANK(DriverActual_Total),
					    DIVIDE(DriverActual_Total, HeadcountActual),
					    BLANK()
					)
					
					```
				lineageTag: 9d6d2fda-2d13-4198-91f1-058934792b8a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

