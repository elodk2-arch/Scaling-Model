			measure 'Actual vs Forecast + Blue Special (Dynamic)' = ```
					
					VAR LatestYM = [Latest Actual YearMonth (Dynamic)]
					VAR CurrentYMText = SELECTEDVALUE('DateTable'[YearMonth])
					VAR CurrentYM = 
					    IF(
					        ISBLANK(CurrentYMText),
					        BLANK(),
					        VALUE(SUBSTITUTE(CurrentYMText, "-", ""))
					    )
					VAR SelectedMeasure = SELECTEDVALUE('Stream split main'[MeasureName])
					
					// --- Determine if there are actuals for this month
					VAR ThisYear = SELECTEDVALUE('DateTable'[Year])
					VAR ThisMonth = SELECTEDVALUE('DateTable'[MonthNumber])
					
					VAR ActualValue =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        FILTER(
					            ALL('DateTable'),
					            'DateTable'[Year] = ThisYear &&
					            'DateTable'[MonthNumber] = ThisMonth
					        ),
					        'Driver Map'[Version] = "Total"
					    )
					
					VAR HasActuals =
					    NOT ISBLANK(ActualValue) &&
					    ActualValue <> 0
					
					RETURN
					IF(
					    ISBLANK(CurrentYM) || ISBLANK(LatestYM),
					    BLANK(),
					    SWITCH(
					        TRUE(),
					        
					        // +5% efficiency -> Blue
					        SelectedMeasure = "9. Activity Scaled FTE + 5%", 3,
					        
					        // Activity Scaled FTE -> Light Yellow
					        SelectedMeasure = "8. Activity Scaled FTE", 4,
					        
					        // Total, Automated, Manual Drivers -> Green if actual, Yellow if forecast
					        SelectedMeasure IN {
					            "1. Total Driver",
					            "2. Automated Driver",
					            "3. Manual Driver"
					        },
					            IF(HasActuals, 1, 2),
					        
					        // Everything else -> White
					        5
					    )
					)
					
					```
				formatString: 0
				lineageTag: 70978959-6370-4b78-b9d2-905ef8341a7d

