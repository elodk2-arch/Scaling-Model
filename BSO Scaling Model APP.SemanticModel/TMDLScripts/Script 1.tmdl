				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Manual Forecast' = ```
					
					VAR ThisYear = SELECTEDVALUE('DateTable'[Year])
					
					VAR BaseYearValue =
					    CALCULATE(
					        [Manual Actuals],
					        'DateTable'[Year] = ThisYear - 1
					    )
					
					VAR GrowthRate = [Output Growth Latest (Numeric)]
					
