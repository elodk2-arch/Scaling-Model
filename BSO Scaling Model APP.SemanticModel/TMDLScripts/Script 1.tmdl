			measure 'Total Manual Driver (Forecast Only)' = ```
					
					VAR ForecastYear = 2025
					VAR CurrentYear = SELECTEDVALUE ( 'DateTable'[Year] )
					
					RETURN
					IF (
					    CurrentYear <> ForecastYear,
					    BLANK(),
					    SUMX (
					        VALUES ( 'DateTable'[MonthNumber] ),
					        VAR CurrentMonth = 'DateTable'[MonthNumber]
					
					        -- Check if a 2025 manual actual exists
					        VAR Actual_2025 =
					            CALCULATE (
					                SUM ( 'Driver Data'[Value] ),
					                'DateTable'[Year] = ForecastYear,
					                'DateTable'[MonthNumber] = CurrentMonth,
					                'Driver Map'[Version] = "Manual",
					                ALLEXCEPT (
					                    'Driver Data',
					                    'Driver Map'[Service Region]
					                )
					            )
					
					        -- Baseline from 2024
					        VAR Baseline_2024 =
					            CALCULATE (
					                SUM ( 'Driver Data'[Value] ),
					                'DateTable'[Year] = ForecastYear - 1,
					                'DateTable'[MonthNumber] = CurrentMonth,
					                'Driver Map'[Version] = "Manual",
					                ALLEXCEPT (
					                    'Driver Data',
					                    'Driver Map'[Service Region]
					                )
					            )
					
					        VAR GrowthPct =
					            CALCULATE (
					                [Output Growth Latest (Numeric)],
					                FILTER (
					                    ALL ( 'DateTable' ),
					                    'DateTable'[Year] = ForecastYear
					                        && 'DateTable'[MonthNumber] = CurrentMonth
					                )
					            )
					
					        RETURN
					            IF (
					                NOT ISBLANK ( Actual_2025 ),
					                BLANK(),        -- 🚫 hard stop: actual month excluded
					                IF (
					                    NOT ISBLANK ( Baseline_2024 )
					                        && NOT ISBLANK ( GrowthPct ),
					                    Baseline_2024 * ( 1 + GrowthPct ),
					                    BLANK()
					                )
					            )
					    )
					)
					
					```
				lineageTag: 81820c27-fbfc-4cb3-b8a6-97b0244c0f67

