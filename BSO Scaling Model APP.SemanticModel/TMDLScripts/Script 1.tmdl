		table 'Stream split year'
			lineageTag: 1e44f96c-6a8a-4348-851f-8faa0b3f1c44

			measure 'Selected Measure Value2' = ```
					
					VAR HeadcountStreams =
					    DATATABLE("Stream", STRING, { {"PY"}, {"EMD"}, {"ESO"}, {"SD"}, {"PC"}, {"TAX"}, {"VMD"} })
					
					VAR SelectedStreams =
					    ALLSELECTED('FTE Data'[Redefind Sub-stream])
					
					VAR SelectedStream =
					    SELECTEDVALUE('FTE Data'[Redefind Sub-stream])
					
					VAR IsHeadcountStream =
					IF(
					    NOT( ISBLANK( SelectedStream ) ),
					    CONTAINSROW( HeadcountStreams, SelectedStream ),
					    COUNTROWS( INTERSECT( SelectedStreams, HeadcountStreams ) ) > 0
					    && COUNTROWS( SelectedStreams ) = COUNTROWS( INTERSECT( SelectedStreams, HeadcountStreams ) )
					)
					
					VAR SelectedMeasure =
					    SELECTEDVALUE('Stream split year'[MeasureName2])
					
					RETURN
					SWITCH(
					    TRUE(),
					
					    -- Headcount streams
					    IsHeadcountStream && SelectedMeasure = "1. Total Driver",
					        [Total Driver (Year)], //yes
					
					    IsHeadcountStream && SelectedMeasure = "10. Total Headcount 2025",
					        [Total Headcount Selected Year], // Yes?
					
					    IsHeadcountStream && SelectedMeasure = "11. No. Driver/ Total Headcount",
					        [Year split HEADCOUNT2], // Hardcoed
					
					    IsHeadcountStream && SelectedMeasure = "7. FTE Actuals",
					        [FTE Yearly Average (Adjusted)],//yes
					
					    IsHeadcountStream && SelectedMeasure = "8. Activity Scaled FTE",
					        [Weighted Activity Scaled], //yes
					
					    IsHeadcountStream && SelectedMeasure = "9. Activity Scaled FTE + 5%",
					        [Weighted Activity Scaled + 5%],//yes
					
					    -- Headcount stream: irrelevant measures = BLANK
					    IsHeadcountStream &&
					    SelectedMeasure IN {
					        "2. Automated Driver",
					        "3. Manual Driver",
					        "4. Manual Ratio",
					        "5. Total Driver - 2025 fallback only",
					        "6. Manual / FTE (actuals)"
					    },
					        BLANK(),
					
					    -- Non-headcount streams
					    SelectedMeasure = "1. Total Driver",
					        [Total Driver (Year)],
					
					    SelectedMeasure = "2. Automated Driver",
					        [Total Automated Driver],
					
					    SelectedMeasure = "3. Manual Driver",
					        [Total Manual Driver],
					
					    SelectedMeasure = "4. Manual Ratio",
					        [Manual rate %],
					
					    SelectedMeasure = "7. FTE Actuals",
					        [FTE Yearly Average (Adjusted)],
					
					    SelectedMeasure = "6. Manual / FTE (actuals)",
					        [Manual Driver / FTE],
					
					    SelectedMeasure = "8. Activity Scaled FTE",
					        [Activity Scaled (Lock in working) yearly],
					
					    SelectedMeasure = "9. Activity Scaled FTE + 5%",
					        [Activity Scaled + 5%(Lock in working) Yearly],
					
					    BLANK()
					)
					
					```
				lineageTag: 552748fb-adeb-417f-9880-6098f1365abd

				annotation PBI_FormatHint = {"isGeneralNumber":true}

