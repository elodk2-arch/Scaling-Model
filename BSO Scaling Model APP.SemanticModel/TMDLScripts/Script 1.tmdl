			measure 'Forecast or Actuals dynamic Manual' = ```
					
					VAR ThisYear  = SELECTEDVALUE('DateTable'[Year])
					VAR ThisMonth = SELECTEDVALUE('DateTable'[MonthNumber])
					
					-- Actuals for current year/month
					VAR ActualValue =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        FILTER(
					            ALL('DateTable'),
					            'DateTable'[Year] = ThisYear &&
					            'DateTable'[MonthNumber] = ThisMonth
					        ),
					        'Driver Map'[Version] = "Manual"
					    )
					
					-- Last year value for same month
					VAR LastYearValue =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        FILTER(
					            ALL('DateTable'),
					            'DateTable'[Year] = ThisYear - 1 &&
					            'DateTable'[MonthNumber] = ThisMonth
					        ),
					        'Driver Map'[Version] = "Manual"
					    )
					
					VAR GrowthRate = [Output Growth Latest (Numeric)]
					
					-- Check if actual exists and is non-zero
					VAR HasActual =
					    NOT(ISBLANK(ActualValue)) && ActualValue <> 0
					
					RETURN
					IF(
					    HasActual,
					    ActualValue,                         -- return actual if > 0
					    LastYearValue * (1 + GrowthRate)     -- return forecast if 0 or missing
					)
					
					```
				lineageTag: a711195e-8470-4b56-bc69-876af338dad3

