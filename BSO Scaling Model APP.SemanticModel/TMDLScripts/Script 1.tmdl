			measure 'Driver Fallback Solid (Manual Only) test 2' = ```
					
					VAR CurrentYear = MAX('DateTable'[Year])
					VAR CurrentMonth = MAX('DateTable'[MonthNumber])
					
					-- Get 2025 manual actuals (respecting Region slicer)
					VAR Driver_CurrentYear =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        'Driver Map'[Version] = "Manual",
					        'DateTable'[Year] = CurrentYear,
					        'DateTable'[MonthNumber] = CurrentMonth,
					        KEEPFILTERS('Driver Map'[Service Region])
					    )
					
					-- Fallback to previous year (respecting Region slicer)
					VAR Driver_PreviousYear =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        'Driver Map'[Version] = "Manual",
					        'DateTable'[Year] = CurrentYear - 1,
					        'DateTable'[MonthNumber] = CurrentMonth,
					        KEEPFILTERS('Driver Map'[Service Region])
					    )
					
					RETURN
					IF(
					    CurrentYear >= YEAR(MIN('Driver Data'[Reporting Date])),
					    IF(
					        NOT ISBLANK(Driver_CurrentYear) && Driver_CurrentYear <> 0,
					        Driver_CurrentYear,
					        Driver_PreviousYear
					    ),
					    BLANK()
					)
					
					```
				lineageTag: 3cbddfda-15fc-4b17-a3c3-9eab71cbb15a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure WeightedActivityScaled_rebuild = ```
					
					VAR CurrSubStreams =
					    VALUES ( BaseProcessWeights[SubStream] )
					
					VAR RowsForContext =
					    FILTER (
					        BaseProcessWeights,
					        BaseProcessWeights[SubStream] IN CurrSubStreams
					    )
					
					RETURN
					SUMX (
					    RowsForContext,
					    VAR WeightFactor =
					        BaseProcessWeights[Weight] / 100
					    VAR ActivityValue =
					        CALCULATE (
					            [Activity Scaled (Year, Avg of Months)],
					            BaseProcessWeights[Driver]
					        )
					    RETURN
					        COALESCE ( ActivityValue, 0 ) * WeightFactor
					)
					
					```
				lineageTag: 81a57031-f4e6-4933-baa5-45058f672f79

				annotation PBI_FormatHint = {"isGeneralNumber":true}

