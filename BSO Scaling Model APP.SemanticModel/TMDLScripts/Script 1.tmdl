			measure 'Manual Driver Forecast (Summable)' = ```
					
					VAR SelectedYear = 2025
					
					-- All months in context (e.g. 2025)
					VAR Months =
					    VALUES('DateTable'[MonthNumber])
					
					RETURN
					SUMX(
					    Months,
					    VAR CurrentMonth = 'DateTable'[MonthNumber]
					
					    -- 2025 Manual Driver (keep Region)
					    VAR Driver_2025 =
					        CALCULATE(
					            SUM('Driver Data'[Value]),
					            'DateTable'[Year] = SelectedYear,
					            'DateTable'[MonthNumber] = CurrentMonth,
					            'Driver Map'[Version] = "Manual"
					        )
					
					    -- 2024 fallback
					    VAR Driver_2024 =
					        CALCULATE(
					            SUM('Driver Data'[Value]),
					            'DateTable'[Year] = SelectedYear - 1,
					            'DateTable'[MonthNumber] = CurrentMonth,
					            'Driver Map'[Version] = "Manual"
					        )
					
					    -- Growth for this month (already version-safe)
					    VAR GrowthPct =
					        CALCULATE(
					            [Output Growth Latest (Numeric)],
					            FILTER(
					                ALL('DateTable'),
					                'DateTable'[Year] = SelectedYear
					                    && 'DateTable'[MonthNumber] = CurrentMonth
					            )
					        )
					
					    RETURN
					        IF(
					            NOT ISBLANK(Driver_2025),
					            Driver_2025,
					            IF(
					                NOT ISBLANK(Driver_2024)
					                    && NOT ISBLANK(GrowthPct),
					                Driver_2024 * (1 + GrowthPct),
					                BLANK()
					            )
					        )
					)
					
					```
				lineageTag: 61b6bf55-2116-4822-bf7b-5cc943f58311

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Yearly Manual Driver per FTE Prev Year (fixed)' = ```
					
					VAR PrevYear =
					    YEAR( MAX( 'Driver Data'[Reporting Date] ) ) - 1
					
					-- Total manual driver, same context except for date
					VAR TotalManualDriverPrevYear =
					    CALCULATE(
					        [Total Manual Driver],
					        REMOVEFILTERS('DateTable'),
					        YEAR('DateTable'[Date]) = PrevYear
					    )
					
					-- Average mapped FTE, same context except for date
					VAR AvgMappedFTEPrevYear =
					    CALCULATE(
					        [Avg Monthly Mapped FTE 2], //old was hardcoded to 2024
					        REMOVEFILTERS('DateTable'),
					        YEAR('DateTable'[Date]) = PrevYear
					    )
					
					RETURN
					DIVIDE(
					    TotalManualDriverPrevYear,
					    AvgMappedFTEPrevYear
					)
					
					```
