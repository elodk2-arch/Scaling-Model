		table 'Measures (2)'
			lineageTag: e70380f5-5c14-4b3f-a935-af455e886050

			measure 'Driver Manual Forecast' = ```
					
					VAR CurrentYear =
					    SELECTEDVALUE('DateTable'[Year])
					VAR CurrentMonth =
					    SELECTEDVALUE('DateTable'[MonthNumber])
					VAR SelectedTNames =
					    ALLSELECTED('Driver Data'[Driver ID])
					
					// Get 2025 actuals
					VAR Driver_2025 =
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    FILTER(
					        'Driver Data',
					        YEAR('Driver Data'[Reporting Date]) = 2025 &&
					        MONTH('Driver Data'[Reporting Date]) = CurrentMonth &&
					        'Driver Data'[Driver ID] IN SelectedTNames
					    ),
					    'Driver Map'[Version] = "Manual",
					    ALLEXCEPT('Driver Map', 'Driver Map'[Service Region])
					)
					
					// Fallback to 2024 same month 
					VAR Driver_2024 =
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    FILTER(
					        'Driver Data',
					        YEAR('Driver Data'[Reporting Date]) = 2024 &&
					        MONTH('Driver Data'[Reporting Date]) = CurrentMonth &&
					        'Driver Data'[Driver ID] IN SelectedTNames
					    ),
					    'Driver Map'[Version] = "Manual",
					    ALLEXCEPT('Driver Map', 'Driver Map'[Service Region])
					)
					
					VAR GrowthPct = [Output Growth Latest (Numeric)]
					
					// fallback with growth
					RETURN
					IF (
					    CurrentYear = 2025,
					    IF (
					        NOT ISBLANK ( Driver_2025 ),
					        Driver_2025,
					        IF (
					            NOT ISBLANK ( Driver_2024 ) && NOT ISBLANK ( GrowthPct ),
					            Driver_2024 * ( 1 + GrowthPct ),
					            BLANK ()
					        )
					    ),
					    BLANK ()
					)
					
					```
				lineageTag: 9c6b0843-8fc6-44e6-a602-eb7d4581c31e

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Total Driver - 2025 Fallback Only' = ```
					
					VAR CurrentYear =
					    SELECTEDVALUE('DateTable'[Year])
					VAR CurrentMonth =
					    SELECTEDVALUE('DateTable'[MonthNumber])
					
					VAR Driver_2024 =
					CALCULATE(
					    SUM('Driver Data'[Value]),
					
					    -- explicitly ignore any Year filter from the visual
					    REMOVEFILTERS('DateTable'[Year]),
					
					    -- reapply the 2024 filter correctly
					    'DateTable'[Year] = 2024,
					    
					    -- keep the current month from the visual
					    'DateTable'[MonthNumber] = CurrentMonth,
					
					    'Driver Map'[Version] = "Total"
					)
					
					RETURN
					IF(
					    CurrentYear = 2025,
					    Driver_2024,
					    BLANK()
					)
					
					```
				lineageTag: a17743bc-1bf0-47bf-b544-caed565d2813

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Latest FTE (Actual or Forecasted)' = ```
					
					VAR CurrentDate = MAX('DateTable'[Date])
					
					//Latest Reported  data date
					VAR LatestActualDateEver =
					    CALCULATE(
					        MAX('FTE Data'[Date]),
					        FILTER(
					            ALL('FTE Data'),
					            NOT(ISBLANK('FTE Data'[Mapped FTE]))
					        )
					    )
					VAR SelectedYear =
					    SELECTEDVALUE('DateTable'[Year])
					
					//Most recent actual
					VAR LastNonBlankDateUpToCurrent =
					    CALCULATE(
					        MAX('FTE Data'[Date]),
					        FILTER(
					            ALL('FTE Data'),
					            'FTE Data'[Date] <= CurrentDate &&
					            NOT(ISBLANK('FTE Data'[Mapped FTE]))
					        )
					    )
					
					//Actual FTE
					VAR ActualFTE =
					    CALCULATE(
					        SUM('FTE Data'[Mapped FTE]),
					        'FTE Data'[Date] = LastNonBlankDateUpToCurrent
					    )
					
					//TKE Ændringer:
					
					VAR LastActualDate =
					    CALCULATE (
					        MAX ( 'FTE Data'[Date] ),
					        REMOVEFILTERS ( 'FTE Data' )
					        , REMOVEFILTERS(DateTable) -- TKE Fjerne filterkontekst på datetable så den returnerer 31/7/2025 også i måneder efter.
					    )
					
					//Forecast fallback
					
					VAR FallBackFTE =
					    CALCULATE (
					        SUM ( 'FTE Data'[Mapped FTE] ),
					        KEEPFILTERS ( 'FTE Data'[Date] = LastActualDate ),
					        REMOVEFILTERS ( 'DateTable' ) ---  Fjerner filterkontekst på datetable men beholder den ovenstående logik.
					    )
					
					RETURN
					    IF (
					        CurrentDate <= LastActualDate,
					        ActualFTE + [Sum of GSO adjustment],        
					        FallBackFTE + [Sum of GSO adjustment]
					
					    )
					
					
					```
				lineageTag: ebf24409-7b1d-41a3-bf05-d05036f2f4e5

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Latest FTE (Actual or Forecasted adjusted)' = ```
					
					VAR CurrentDate = MAX('DateTable'[Date])
					VAR CurrentYear = YEAR(TODAY())
					
					-- Latest reported actual data date
					VAR LatestActualDateEver =
					    CALCULATE(
					        MAX('FTE Data'[crfc0_fte_dataid]),
					        FILTER(
					            ALL('FTE Data'),
					            NOT ISBLANK('FTE Data'[Mapped FTE])
					
					        )
					    )
					
					VAR SelectedYear =
					    SELECTEDVALUE('DateTable'[Year])
					
					-- Most recent actual up to current date
					VAR LastNonBlankDateUpToCurrent =
					    CALCULATE(
					        MAX('FTE Data'[Date]),
					        FILTER(
					            ALL('FTE Data'),
					            'FTE Data'[Date] <= CurrentDate &&
					            NOT ISBLANK('FTE Data'[Mapped FTE]) 
					
					        )
					    )
					
					-- Actual FTE
					VAR ActualFTE =
					    CALCULATE(
					        SUM('FTE Data'[Mapped FTE]),
					        'FTE Data'[Date] = LastNonBlankDateUpToCurrent
					
					    )
					
					-- Latest available actual date (ignores all date filters)
					VAR LastActualDate =
					    CALCULATE(
					        MAX('FTE Data'[Date]),
					        REMOVEFILTERS('FTE Data'),
					        REMOVEFILTERS('DateTable')
					    )
					
					-- Forecast fallback FTE
					VAR FallBackFTE =
					    CALCULATE(
					        SUM('FTE Data'[Mapped FTE]),
					        KEEPFILTERS('FTE Data'[Date] = LastActualDate),
					 
					        REMOVEFILTERS('DateTable')
					    )
					
					-- Adjustments
					VAR AdjustedActualFTE =
					    ActualFTE +
					    IF(
					        YEAR(CurrentDate) = SelectedYear,
					        [Sum of GSO Adjustment],
					        0
					    )
					
					VAR AdjustedFallbackFTE =
					    FallBackFTE +
					    IF(
					        YEAR(CurrentDate) = SelectedYear,
					        [Sum of GSO Adjustment],
					        0
					    )
					RETURN
					    IF(
					        CurrentDate <= LastActualDate,
					        AdjustedActualFTE,
					        AdjustedFallbackFTE
					    )
					
					```
				lineageTag: da59d554-e0dc-4d97-aa0d-63872ceccfa4

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Manual Driver Forecast 2 2' = ```
					
					VAR CurrentYear = SELECTEDVALUE('DateTable'[Year])
					VAR CurrentMonth = SELECTEDVALUE('DateTable'[MonthNumber])
					
					-- NEW: Capture BaseProcess from slicer
					VAR SelectedBaseProcesses =
					    ALLSELECTED('Driver Map'[Driver Family])
					
					VAR Driver_2025 =
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    YEAR('Driver Data'[Reporting Date]) = 2025,
					    MONTH('Driver Data'[Reporting Date]) = CurrentMonth,
					    'Driver Map'[Version] = "manual",
					    'Driver Map'[Driver family] IN SelectedBaseProcesses,
					    ALLEXCEPT('Driver Map', 'Driver Map'[Service Region])
					)
					
					    
					
					VAR Driver_2024 =
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    YEAR('Driver Data'[Reporting Date]) = 2024,
					    MONTH('Driver Data'[Reporting Date]) = CurrentMonth,
					    'Driver Map'[Version] = "manual",
					    'Driver Map'[Driver family] IN SelectedBaseProcesses,
					    ALLEXCEPT('Driver Map', 'Driver Map'[Service Region])
					)
					
					
					VAR GrowthPct = [Output Growth Latest (Numeric)]
					
					RETURN
					IF(
					    CurrentYear = 2025,
					    IF(
					        NOT ISBLANK(Driver_2025),
					        Driver_2025,
					        IF(
					            NOT ISBLANK(Driver_2024) && NOT ISBLANK(GrowthPct),
					            Driver_2024 * (1 + GrowthPct),
					            BLANK()
					        )
					    ),
					    BLANK()
					)
					
					```
				lineageTag: ef899c41-1901-4dfd-b4c9-dcf838870675

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Total Manual Driver' = ```
					
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    'Driver Map'[Version] = "Manual"
					)
					
					```
				lineageTag: 4ababba9-d42d-448a-82cd-97608d4689a6

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Activity Scaled (test)' = ```
					
					VAR Baseline = 
