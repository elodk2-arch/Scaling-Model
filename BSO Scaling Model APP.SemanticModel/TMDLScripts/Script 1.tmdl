			measure 'WeightedActivityScaled_FINAL +5%' = ```
					
					VAR CurrentStream =
					    SELECTEDVALUE('FTE Map'[Substream Abbreviation])
					
					VAR IsHeadcountOrSplitStream =
					    CurrentStream IN { "PY", "EMD", "ESO", "SD" }
					
					RETURN
					IF (
					    IsHeadcountOrSplitStream,
					
					    SUMX (
					        BaseProcessWeights,
					        VAR w = BaseProcessWeights[Weight] / 100
					        VAR drv = BaseProcessWeights[Driver]
					        VAR val =
					            CALCULATE(
					                [Activity Scaled (FINAL) + 5%],
					                BaseProcessWeights[Driver] = drv
					            )
					        RETURN COALESCE(val,0) * w
					    ),
					
					    [Activity Scaled Year + 5%]
					)
					
					```
				lineageTag: fcdc592c-624f-40a4-94f2-29022dc85e93

