			measure 'KPI Activity Scaled Switch' = ```
					
					VAR SelectedSubStream =
					    SELECTEDVALUE('FTE Map'[Substream Abbreviation])
					
					VAR ResultPerRow =
					    SWITCH(
					        TRUE(),
					        SelectedSubStream IN { "ESO", "GL", "TAX", "SD", "PC", "VMD" },
					            CALCULATE([WeightedActivityScaled_FINAL +5%], ALL('FTE Data'[Date])),
					
					        SelectedSubStream IN { "EMD", "ESO", "PY", "SD" },
					            CALCULATE([WeightedActivityScaled_FINAL +5%], ALL('FTE Data'[Date])),
					
					        CALCULATE([Activity Scaled Year + 5%], ALL('FTE Data'[Date]))
					    )
					
					RETURN
					IF(
					    ISINSCOPE('FTE Map'[Substream Abbreviation]),
					    ResultPerRow,
					    SUMX(
					        VALUES('FTE Map'[Substream Abbreviation]),
					        ResultPerRow
					    )
					)
					
					```
