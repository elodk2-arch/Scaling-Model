			measure 'Output Forecasted' = ```
					
					VAR ActualValue =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        'Driver Map'[Version] = "Total"
					    )
					
					VAR LastYearValue = [Total Driver Last Year (dynamic)]
					VAR Growth = [Output Growth (%)] / 100  // convert percent to multiplier
					
					RETURN
					IF(
					    NOT ISBLANK(ActualValue),
					    ActualValue,              // use actual if it exists
					    LastYearValue * (1 + Growth)   // otherwise forecast
					)
					
					```
				lineageTag: 59c02901-f63a-4871-8284-ce4a25ad6cbb

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Forecast Simple' = ```
					
					[Total Driver Last Year (dynamic)] * ([Output Growth (%)] / 100 + 1)
					
					```
				lineageTag: b2eeca20-f9ef-4bcd-881e-7862c48e1b7c

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Forecast With Actuals' = ```
					
					VAR ActualValue =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        'Driver Map'[Version] = "Total"
					    )
					
					RETURN
					IF(
					    NOT ISBLANK(ActualValue),
					    ActualValue,
					    [Forecast Simple]
					)
					
					```
				lineageTag: 8bc3745b-553a-4642-9797-5ffb8b2dbd38

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Forecast or Actuals dynamic YEAR total' = ```
					
					VAR ThisYear =
					    SELECTEDVALUE ( 'DateTable'[Year] )
					
					VAR GrowthRate =
					    [Output Growth Latest (Numeric)]
					
					RETURN
					SUMX (
					    VALUES ( 'DateTable'[MonthNumber] ),
					    VAR ThisMonth = 'DateTable'[MonthNumber]
					
					    VAR ActualValue =
					        CALCULATE (
					            SUM ( 'Driver Data'[Value] ),
					            'DateTable'[Year] = ThisYear,
					            'DateTable'[MonthNumber] = ThisMonth,
					            'Driver Map'[Version] = "Total"
					        )
					
					    VAR LastYearValue =
					        CALCULATE (
					            SUM ( 'Driver Data'[Value] ),
					            'DateTable'[Year] = ThisYear - 1,
					            'DateTable'[MonthNumber] = ThisMonth,
					            'Driver Map'[Version] = "Total"
					        )
					
					    RETURN
					        IF (
					            NOT ISBLANK ( ActualValue ),
					            ActualValue,
					            LastYearValue + ( LastYearValue * GrowthRate )
					        )
					)
					
					```
				lineageTag: c44b983d-0301-42da-a79e-c74a48108599

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Driver per Headcount (Actual Only) (TEST)' = ```
					
