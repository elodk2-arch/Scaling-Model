			measure 'Driver Total Forecast (test) 2' = ```
					
					VAR CurrentYear =
					    SELECTEDVALUE('DateTable'[Year])
					
					VAR CurrentMonth =
					    SELECTEDVALUE('DateTable'[MonthNumber])
					
					-- Headcount for the current month (already context-aware)
					VAR CurrentMonthHeadcount =
					    [Headcount per Month]
					
					-- Average Driver per Headcount for PREVIOUS months in the SAME selected year
					VAR AvgKnownDriverPerHeadcount =
					    CALCULATE(
					        AVERAGEX(
					            VALUES('DateTable'[MonthNumber]),
					            [Driver per Headcount]
					        ),
					        FILTER(
					            ALL('DateTable'),
					            'DateTable'[Year] = CurrentYear &&
					            'DateTable'[MonthNumber] < CurrentMonth &&
					            NOT ISBLANK([Driver per Headcount])
					        )
					    )
					
					-- Actual driver value for the current month (if it exists)
					VAR DriverActual =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        'DateTable'[Year] = CurrentYear,
					        'DateTable'[MonthNumber] = CurrentMonth,
					        'Driver Map'[Version] = "Total"
					    )
					
					-- Forecast if actual is missing
					VAR DriverForecast =
					    CurrentMonthHeadcount * AvgKnownDriverPerHeadcount
					
					RETURN
					IF(
					    NOT ISBLANK(DriverActual),
					    DriverActual,
					    DriverForecast
					)
					
					```
				lineageTag: 547d328c-58d5-47f8-8ba3-dba8f91abf0b

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Driver per Headcount' = ```
					
					VAR CurrentYear =
					    SELECTEDVALUE('DateTable'[Year])
					
					VAR CurrentMonth =
					    SELECTEDVALUE('DateTable'[MonthNumber])
					
					VAR Headcount_Current =
					    [Headcount per Month]
					
					VAR DriverActual =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        'Driver Data'[Reporting Date] >= DATE(CurrentYear, CurrentMonth, 1),
					        'Driver Data'[Reporting Date] <  EOMONTH(DATE(CurrentYear, CurrentMonth, 1), 0) + 1,
					        'Driver Map'[Version] = "Total"
					    )
					
					RETURN
					DIVIDE(DriverActual, Headcount_Current)
					
					```
				lineageTag: a4c7dae2-f5a0-4640-b881-f2ad7843815d

