






















createOrReplace

	model Model
		culture: en-US
		defaultPowerBIDataSourceVersion: powerBI_V3
		sourceQueryCulture: en-DK
		dataAccessOptions
			legacyRedirects
			returnErrorValuesAsNull

		table 'Driver Data'
			lineageTag: 09c6d5a6-b648-45aa-97c3-2f9361882e3f

			measure 'Output Last 12 Months' = ```
					
					VAR LastActualDate =
					    CALCULATE(
					        MAX('Driver Data'[Reporting Date]),
					        'Driver Map'[Version] = "Total",
					        'Driver Data'[Value] <> 0,
					        ALL('DateTable')  // Ignore any date slicers
					    )
					RETURN
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    'Driver Map'[Version] = "Total",
					    DATESINPERIOD(
					        'Driver Data'[Reporting Date],
					        LastActualDate,
					        -12,
					        MONTH
					    ),
					    ALL('DateTable')  // Ignore any date slicers
					)
					
					```
				lineageTag: 833d2acd-61c9-401b-9166-e42d56fb10b5

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Output Previous 12 Months' = ```
					
					VAR LastActualDate =
					    CALCULATE(
					        MAX('Driver Data'[Reporting Date]),
					        'Driver Map'[Version] = "Total",
					        'Driver Data'[Value] <> 0,
					        ALL('DateTable')  // Ignore any slicers
					    )
					VAR PrevEndDate = EDATE(LastActualDate, -12)
					RETURN
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    'Driver Map'[Version] = "Total",
					    DATESINPERIOD(
					        'Driver Data'[Reporting Date],
					        PrevEndDate,
					        -12,
					        MONTH
					    ),
					    ALL('DateTable')  // Ignore any slicers
					)
					
					```
				lineageTag: 9a2ba972-7810-4657-b3e8-ec42effb9a3b

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Output Growth (Numeric)' = ```
					
					DIVIDE(
					    [Output Last 12 Months],
					    [Output Previous 12 Months]
					) -1
					
					```
				lineageTag: 2ae15a37-18fd-4cc1-9202-2aedda1a04f7

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Output Growth Latest (Numeric)' = ```
					
					CALCULATE(
					    [Output Growth (Numeric)],
					    REMOVEFILTERS('DateTable')
					)
					
					```
				lineageTag: b5090eea-b500-458e-ab40-9b0288d2fece

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Driver total Forecast' = ```
					
					VAR CurrentYear =
					    SELECTEDVALUE('DateTable'[Year])
					VAR CurrentMonth =
					    SELECTEDVALUE('DateTable'[MonthNumber])
					VAR SelectedTNames =
					    ALLSELECTED('Driver Data'[Driver ID])
					
					// Get 2025 actuals
					VAR Driver_2025 =
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    'DateTable'[Year] = 2025,
					    'DateTable'[MonthNumber] = CurrentMonth,
					    'Driver Data'[Driver ID] IN SelectedTNames,
					    'Driver Map'[Version] = "total",
					    ALLEXCEPT('Driver Data', 'Driver Map'[Service Region])
					)
					
					
					// Fallback to 2024 same month 
					VAR Driver_2024 =
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    'DateTable'[Year] = 2024,
					    'DateTable'[MonthNumber] = CurrentMonth,
					    'Driver Data'[Driver ID] IN SelectedTNames,
					    'Driver Map'[Version] = "total",
					    ALLEXCEPT('Driver Data', 'Driver Map'[Service Region])
					)
					
					
					VAR GrowthPct = [Output Growth Latest (Numeric)]
					
					// fallback with growth
					RETURN
					IF (
					    CurrentYear = 2025,
					    IF (
					        NOT ISBLANK ( Driver_2025 ),
					        Driver_2025,
					        IF (
					            NOT ISBLANK ( Driver_2024 ) && NOT ISBLANK ( GrowthPct ),
					            Driver_2024 * ( 1 + GrowthPct ),
					            BLANK ()
					        )
					    ),
					    BLANK ()
					)
					
					```
				lineageTag: f82d8833-5c18-423d-8361-520aaa6d5492

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Output Growth (%)' = ```
					
					VAR Output_Last = [Output Last 12 Months]
					VAR Output_Prev = [Output Previous 12 Months]
					RETURN
					IF(
					    Output_Prev = 0 || ISBLANK(Output_Prev),
					    BLANK(),
					    (Output_Last / Output_Prev - 1) * 100
					)
					
					```
				lineageTag: 636ec4ee-4e93-41bc-92ee-667bf8d70c26

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Debug – LastYear' = ```
					
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    'DateTable'[Year] = 2023,
					    'Driver Map'[Version] = "Manual"
					)
					
					```
				lineageTag: 39ebcd7b-9b80-4e87-b3f3-f7043b309d7f

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Output Last 12 Months (manual ITSD)' = ```
					
					VAR LastActualDate =
					    CALCULATE(
					        MAX('Driver Data'[Reporting Date]),
					        'Driver Map'[Version] = "Manual",
					        'Driver Data'[Value] <> 0,
					        ALL('DateTable')  // Ignore any date slicers
					    )
					RETURN
					CALCULATE(
					    SUM('Driver Data'[Value]),
					    'Driver Map'[Version] = "Manual",
					    DATESINPERIOD(
					        'Driver Data'[Reporting Date],
					        LastActualDate,
					        -12,
					        MONTH
					    ),
					    ALL('DateTable')  // Ignore any date slicers
					)
					
					```
