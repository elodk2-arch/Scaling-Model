		table 'Stream split Year 2025'
			lineageTag: 6f5215d3-39f9-4fc0-824d-525ca9623398

			measure 'Selected Measure Value (Yealy)' = ```
					
					VAR HeadcountStreams =
					    DATATABLE (
					        "Stream", STRING,
					        {
					            {"EMD"},
					            {"ESO"},
					            {"PY"},
					            {"SD"}
					        }
					    )
					
					VAR SelectedStreams =
					    ALLSELECTED ( 'FTE Map'[Substream Abbreviation] )
					
					VAR IsHeadcountStream =
					    COUNTROWS (
					        INTERSECT ( SelectedStreams, HeadcountStreams )
					    ) > 0
					    &&
					    COUNTROWS ( SelectedStreams )
					        = COUNTROWS (
					            INTERSECT ( SelectedStreams, HeadcountStreams )
					        )
					
					VAR IsGL =
					    COUNTROWS (
					        FILTER (
					            SelectedStreams,
					            'FTE Map'[Substream Abbreviation] = "GL"
					        )
					    ) > 0
					
					VAR SelectedMeasure =
					    SELECTEDVALUE ( 'Stream split Year 2025'[MeasureName3] )
					
					RETURN
					SWITCH (
					    TRUE(),
					
					
					    IsGL && SelectedMeasure = "71. Vacancy Positions", [Vacancy],
					
					
					    IsHeadcountStream && SelectedMeasure = "1. Total Driver",
					        [Total Driver (Year)],
					
					    IsHeadcountStream && SelectedMeasure = "10. Total Headcount 2025",
					        [Total Headcount Selected Year],
					
					    IsHeadcountStream && SelectedMeasure = "11. No. of driver / Total Headcount",
					        [Year split HEADCOUNT],
					
					    IsHeadcountStream && SelectedMeasure = "7. FTE Actuals",
					        [FTE Yearly Average (Adjusted)],
					
					    IsHeadcountStream && SelectedMeasure = "8. Activity Scaled FTE",
					        [WeightedActivityScaled_FINAL],
					
					    IsHeadcountStream && SelectedMeasure = "9. Activity Scaled FTE + 5%",
					        [WeightedActivityScaled_FINAL +5%],
					
					    IsHeadcountStream
					        && SelectedMeasure IN {
					            "2. Automated Driver",
					            "3. Manual Driver",
					            "4. Manual Ratio",
					            "5. Total Driver - Last Year SM",
					            "6. Manual / FTE (actuals)"
					        },
					        BLANK(),
					
					    -- =========================
					    -- Non-headcount streams
					    -- =========================
					    SelectedMeasure = "1. Total Driver",
					        [Total Driver (Year)],
					
					    SelectedMeasure = "2. Automated Driver",
					        VAR AutoVal = [Automated Driver (Year)]
					        RETURN
					            IF ( AutoVal = 0 || ISBLANK ( AutoVal ), BLANK (), AutoVal ),
					
					    SelectedMeasure = "3. Manual Driver",
					        [Manual Driver (Year)],
					
					    SelectedMeasure = "4. Manual Ratio",
					        [Manual Rate (Year)],
					
					    SelectedMeasure = "5. Total Driver - Last Year SM",
					        [Total Driver Last Year (dynamic)],
					
					    SelectedMeasure = "6. Manual / FTE (actuals)",
					        [Manuals per FTE (Year Avg) (summable)],
					
					    SelectedMeasure = "7. FTE Actuals",
					        [Avg FTE (Year, Using Latest Measure)],
					
					    SelectedMeasure = "8. Activity Scaled FTE",
					        [Activity Scaled (Year, Avg of Months)],
					
					    SelectedMeasure = "9. Activity Scaled FTE + 5%",
					        [Activity Scaled Year + 5%],
					
					    BLANK()
					)
					
					```
				lineageTag: fe17a413-8fa7-4fa8-a805-6edd0282bf7f

				annotation PBI_FormatHint = {"isGeneralNumber":true}

