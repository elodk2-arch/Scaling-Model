			measure 'Manual Driver Forecast 2 (Year Sum) (test)' = ```
					
					VAR SelectedYear = 2025
					VAR GrowthPct = [Output Growth Latest (Numeric)]
					
					VAR ManualDrivers =
					    CALCULATETABLE(
					        VALUES ( 'Driver Data'[Driver ID] ),
					        'Driver Map'[Version] = "Manual"
					    )
					
					RETURN
					SUMX(
					    VALUES ( 'DateTable'[MonthNumber] ),
					    VAR CurrentMonth = 'DateTable'[MonthNumber]
					
