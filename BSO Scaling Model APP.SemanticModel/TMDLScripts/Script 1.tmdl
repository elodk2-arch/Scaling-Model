		table 'Driver Map'
			lineageTag: 56e22c2f-d628-4490-b3ba-817c574444cc

			measure 'Driver Total incl. Forecast (headcount)' = ```
					
					VAR CurrentYear =
					    SELECTEDVALUE('DateTable'[Year])
					
					VAR CurrentMonth =
					    SELECTEDVALUE('DateTable'[MonthNumber])
					
					-- Headcount for the current month (future allowed)
					VAR CurrentMonthHeadcount =
					    [Headcount per Month]
					
					-- Average of Driver/Headcount from ACTUAL months only (Version = total)
					VAR AvgDriverPerHeadcount_UntilNow =
					    CALCULATE(
					        AVERAGEX(
					            FILTER(
					                ALL('DateTable'),
					                'DateTable'[Year] = CurrentYear &&
					                'DateTable'[MonthNumber] < CurrentMonth
					            ),
					            [Driver per Headcount (Actual Only)]
					        )
					    )
					
					-- Actual Driver value for current month (Version = total only)
					VAR DriverActual_Total =
					    CALCULATE(
					        SUM('Driver Data'[Value]),
					        'Driver Map'[Version] = "total"
					    )
					
					-- Forecast
					VAR DriverForecast =
					    CurrentMonthHeadcount * AvgDriverPerHeadcount_UntilNow
					
					RETURN
					IF(
					    NOT ISBLANK(DriverActual_Total),
					    DriverActual_Total,
					    DriverForecast
					)
					
					```
				lineageTag: 3dad0a78-4011-48b7-8986-e5610de61d04

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure '_Debug Activity by Driver' = ```
					
